{
  "kind": "collectionType",
  "collectionName": "software_releases",
  "info": {
    "singularName": "software-release",
    "pluralName": "software-releases",
    "displayName": "Software Release",
    "description": "Version releases and their change notes"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "version": {
      "type": "string",
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "releaseDate": {
      "type": "date",
      "required": true
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "changes": {
      "type": "component",
      "repeatable": true,
      "component": "downloads.release-change"
    },
    "downloadFile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "downloadUrl": {
      "type": "string"
    },
    "isLatest": {
      "type": "boolean",
      "default": false
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
