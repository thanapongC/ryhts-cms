{
  "kind": "singleType",
  "collectionName": "navigations",
  "info": {
    "singularName": "navigation",
    "pluralName": "navigations",
    "displayName": "Site - Navigation",
    "description": "Site navigation menus (header, footer, etc.)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "headerItems": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.nav-item"
    },
    "footerSections": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.footer-section"
    },
    "footerLabels": {
      "type": "component",
      "repeatable": false,
      "component": "shared.footer-labels"
    },
    "productNames": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.product-name"
    },
    "buttonLabels": {
      "type": "component",
      "repeatable": false,
      "component": "shared.button-labels"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
