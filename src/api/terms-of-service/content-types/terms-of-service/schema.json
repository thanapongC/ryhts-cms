{
  "kind": "singleType",
  "collectionName": "terms_of_services",
  "info": {
    "singularName": "terms-of-service",
    "pluralName": "terms-of-services",
    "displayName": "Page - Terms of Service",
    "description": "Terms of Service page content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Terms of Service"
    },
    "description": {
      "type": "text",
      "description": "Short summary of the terms"
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Hero or featured image"
    },
    "content": {
      "type": "richtext",
      "description": "Full terms of service content"
    },
    "effective_date": {
      "type": "date",
      "description": "Date the terms took effect"
    },
    "last_updated": {
      "type": "date",
      "description": "When the terms were last updated"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta"
    }
  }
}
