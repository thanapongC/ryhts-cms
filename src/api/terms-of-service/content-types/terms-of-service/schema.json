{
  "kind": "singleType",
  "collectionName": "terms_of_services",
  "info": {
    "singularName": "terms-of-service",
    "pluralName": "terms-of-services",
    "displayName": "Terms of Service",
    "description": "Terms of Service page content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Terms of Service"
    },
    "description": {
      "type": "text",
      "description": "Short summary of the terms"
    },
    "content": {
      "type": "richtext",
      "description": "Full terms of service content"
    },
    "last_updated": {
      "type": "datetime",
      "description": "When the terms were last updated"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "text",
      "maxLength": 160
    }
  }
}
