{
  "kind": "singleType",
  "collectionName": "support_pages",
  "info": {
    "singularName": "support-page",
    "pluralName": "support-pages",
    "displayName": "Page - Support",
    "description": "Support page content: hero, FAQ, help center, contact"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroSection": {
      "type": "component",
      "component": "support.hero-section"
    },
    "statusCard": {
      "type": "component",
      "component": "support.status-card"
    },
    "faqSection": {
      "type": "component",
      "component": "support.faq-section"
    },
    "faqs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "helpCenterSection": {
      "type": "component",
      "component": "support.help-center-section"
    },
    "helpResources": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "contactSection": {
      "type": "component",
      "component": "support.contact-section"
    },
    "contactSettings": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::global-setting.global-setting"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo-meta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
