{
  "kind": "singleType",
  "collectionName": "support_pages",
  "info": {
    "singularName": "support-page",
    "pluralName": "support-pages",
    "displayName": "Page - Support",
    "description": "Customer support landing page with hero, FAQ, help resources, contact information, and SEO"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "isPageEnabled": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "heroSection": {
      "type": "component",
      "repeatable": false,
      "component": "support.hero-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "statusCard": {
      "type": "component",
      "repeatable": false,
      "component": "support.status-card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faqSection": {
      "type": "component",
      "repeatable": false,
      "component": "support.faq-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faqs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "helpCenterSection": {
      "type": "component",
      "repeatable": false,
      "component": "support.help-center-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "helpResources": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::help-item.help-item"
    },
    "contactSection": {
      "type": "component",
      "repeatable": false,
      "component": "support.contact-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactSettings": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::global-setting.global-setting"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo-meta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
