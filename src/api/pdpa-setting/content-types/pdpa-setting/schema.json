{
  "kind": "singleType",
  "collectionName": "pdpa_settings",
  "info": {
    "singularName": "pdpa-setting",
    "pluralName": "pdpa-settings",
    "displayName": "Site - PDPA Setting",
    "description": "PDPA compliance settings - DPO, consent banner, data retention"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "companyName": {
      "type": "string",
      "required": true,
      "description": "Company name as registered under PDPA"
    },
    "dpoName": {
      "type": "string",
      "description": "Data Protection Officer name"
    },
    "dpoPosition": {
      "type": "string",
      "description": "DPO job title or position"
    },
    "dpoEmail": {
      "type": "email",
      "description": "DPO contact email"
    },
    "dpoPhone": {
      "type": "string",
      "description": "DPO contact phone"
    },
    "contactInfo": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-info",
      "description": "DPO contact details"
    },
    "dataRetentionDays": {
      "type": "integer",
      "default": 365,
      "min": 1,
      "description": "Default data retention period in days"
    },
    "dataRetentionDescription": {
      "type": "text",
      "description": "Explanation of data retention policy"
    },
    "rightsText": {
      "type": "richtext",
      "description": "Data subject rights explanation"
    },
    "thirdPartiesText": {
      "type": "richtext",
      "description": "Third-party data sharing disclosure"
    },
    "consentBanner": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cookie-consent-settings",
      "description": "Consent banner labels and descriptions"
    },
    "privacyPolicyUrl": {
      "type": "string",
      "description": "Link to full privacy policy page"
    },
    "cookiePolicyUrl": {
      "type": "string",
      "description": "Link to full cookie policy page"
    },
    "contactText": {
      "type": "text",
      "description": "Instructions for contacting DPO"
    },
    "appliesToProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "pdpaAppliedIn"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Enable/disable PDPA compliance features"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo-meta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
