{
  "kind": "singleType",
  "collectionName": "pdpa_settings",
  "info": {
    "singularName": "pdpa-setting",
    "pluralName": "pdpa-settings",
    "displayName": "Site - PDPA Setting",
    "description": "PDPA compliance settings - DPO, consent banner, data retention"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "company_name": {
      "type": "string",
      "required": true,
      "description": "Company name as registered under PDPA"
    },
    "dpo_name": {
      "type": "string",
      "description": "Data Protection Officer name"
    },
    "dpo_position": {
      "type": "string",
      "description": "DPO job title or position"
    },
    "dpo_email": {
      "type": "email",
      "description": "DPO contact email"
    },
    "dpo_phone": {
      "type": "string",
      "description": "DPO contact phone"
    },
    "contact_info": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-info",
      "description": "DPO contact details"
    },
    "data_retention_days": {
      "type": "integer",
      "default": 365,
      "min": 1,
      "description": "Default data retention period in days"
    },
    "data_retention_description": {
      "type": "text",
      "description": "Explanation of data retention policy"
    },
    "rights_text": {
      "type": "richtext",
      "description": "Data subject rights explanation"
    },
    "third_parties_text": {
      "type": "richtext",
      "description": "Third-party data sharing disclosure"
    },
    "consent_banner_title": {
      "type": "string",
      "description": "Cookie consent banner heading text"
    },
    "consent_banner_description": {
      "type": "text",
      "description": "Cookie consent banner description text"
    },
    "consent_accept_all_text": {
      "type": "string",
      "default": "Accept All"
    },
    "consent_reject_all_text": {
      "type": "string",
      "default": "Reject All"
    },
    "consent_manage_text": {
      "type": "string",
      "default": "Manage Preferences"
    },
    "consent_save_text": {
      "type": "string",
      "default": "Save Preferences"
    },
    "privacy_policy_url": {
      "type": "string",
      "description": "Link to full privacy policy page"
    },
    "cookie_policy_url": {
      "type": "string",
      "description": "Link to full cookie policy page"
    },
    "contact_text": {
      "type": "text",
      "description": "Instructions for contacting DPO"
    },
    "applies_to_products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "pdpa_applied_in"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Enable/disable PDPA compliance features"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta"
    }
  }
}
