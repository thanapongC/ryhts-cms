{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site - Settings",
    "description": "General site settings - company name, logo, description"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "site_name": {
      "type": "string",
      "required": true
    },
    "site_logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "site_favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "site_description": {
      "type": "text"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat-item",
      "description": "Key site statistics (e.g. customers, products, years)"
    },
    "currency": {
      "type": "string",
      "default": "THB"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "og_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Default Open Graph image for the site"
    }
  }
}
