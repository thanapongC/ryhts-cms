{
  "kind": "singleType",
  "collectionName": "global_settings",
  "info": {
    "singularName": "global-setting",
    "pluralName": "global-settings",
    "displayName": "Site - Global Settings",
    "description": "Site-wide settings: header, footer contact, stats, and SEO defaults"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "description": "Localized site name"
    },
    "siteLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Site logo image"
    },
    "contactInfo": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-info",
      "description": "Site-wide contact information blocks"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat-item",
      "description": "Key site statistics (e.g. customers, products, years)"
    },
    "seoConfig": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo-config",
      "description": "Site-wide SEO defaults, social profiles, and analytics IDs"
    }
  }
}
