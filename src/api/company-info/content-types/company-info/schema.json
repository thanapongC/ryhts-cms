{
  "kind": "singleType",
  "collectionName": "company_infos",
  "info": {
    "singularName": "company-info",
    "pluralName": "company-infos",
    "displayName": "Company Info",
    "description": "Company contact information - address, phone, hours"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "company_name": {
      "type": "string",
      "required": true
    },
    "company_name_en": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "map_link": {
      "type": "string"
    },
    "business_hours": {
      "type": "text"
    },
    "customer_count": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "contact_form_title": {
      "type": "string"
    }
  }
}
