{
  "kind": "singleType",
  "collectionName": "company_infos",
  "info": {
    "singularName": "company-info",
    "pluralName": "company-infos",
    "displayName": "Site - Company Info",
    "description": "Company contact information - address, phone, hours"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "company_name": {
      "type": "string",
      "required": true,
      "description": "Company name in Thai"
    },
    "company_name_en": {
      "type": "string",
      "description": "Company name in English"
    },
    "address": {
      "type": "text",
      "description": "Full address"
    },
    "phone": {
      "type": "string",
      "description": "Main phone number"
    },
    "email": {
      "type": "email",
      "description": "Main email address"
    },
    "business_hours": {
      "type": "text",
      "description": "Business operating hours"
    },
    "map_link": {
      "type": "string",
      "description": "Google Maps embed URL"
    },
    "customer_count": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "description": "Number of customers (for display)"
    },
    "contact_info": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-info",
      "description": "Structured contact items with icons"
    }
  }
}
