{
  "kind": "singleType",
  "collectionName": "privacy_policies",
  "info": {
    "singularName": "privacy-policy",
    "pluralName": "privacy-policies",
    "displayName": "Page - Privacy Policy",
    "description": "Privacy policy page content - PDPA-compliant privacy disclosure"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Privacy Policy"
    },
    "description": {
      "type": "text",
      "description": "Short summary of the privacy policy"
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Hero or featured image"
    },
    "content": {
      "type": "richtext",
      "description": "Full privacy policy content (PDPA-compliant)"
    },
    "policy_sections": {
      "type": "component",
      "repeatable": true,
      "component": "privacy.policy-section",
      "description": "Structured policy sections with headings"
    },
    "effective_date": {
      "type": "date",
      "description": "Date the privacy policy took effect"
    },
    "last_updated": {
      "type": "date",
      "description": "When the privacy policy was last updated"
    },
    "applies_to_products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "privacy_applied_in"
    },
    "related_links": {
      "type": "component",
      "repeatable": true,
      "component": "privacy.related-link",
      "description": "Related links (e.g. product-specific policies)"
    },
    "contact_info": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-info",
      "description": "Contact information for privacy inquiries"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo-meta"
    }
  }
}
