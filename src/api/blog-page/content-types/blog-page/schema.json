{
  "kind": "singleType",
  "collectionName": "blog_pages",
  "info": {
    "singularName": "blog-page",
    "pluralName": "blog-pages",
    "displayName": "Page - Blog",
    "description": "Blog listing page content, labels, featured articles, and SEO"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "isPageEnabled": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "heroSection": {
      "type": "component",
      "repeatable": false,
      "component": "blog.hero-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "listingSection": {
      "type": "component",
      "repeatable": false,
      "component": "blog.listing-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featuredPosts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo-meta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
