{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": "Business partners for About page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Partner company name"
    },
    "websiteUrl": {
      "type": "string",
      "description": "Partner website URL"
    },
    "description": {
      "type": "text",
      "description": "Brief description of the partnership"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Partner logo image"
    },
    "aboutPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::about-page.about-page",
      "inversedBy": "partners"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "description": "Display order (lower number appears first)"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Show or hide this partner on frontend"
    }
  }
}
