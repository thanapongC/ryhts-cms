      "type": "boolean",
      "default": true,
      "description": "Enable/disable the floating contact widget"
    },
    "buttonLabel": {
      "type": "string",
      "description": "Floating button label"
    },
    "panelTitle": {
      "type": "string",
      "description": "Contact panel heading"
    },
    "panelDescription": {
      "type": "text",
      "description": "Contact panel description"
    },
    "closeLabel": {
      "type": "string",
      "description": "Close button label"
    },
    "actions": {
      "type": "component",
      "repeatable": true,
      "component": "contact-floating.contact-action",
      "description": "Contact action buttons (phone, email, line, etc.)"
    }
  }
}
