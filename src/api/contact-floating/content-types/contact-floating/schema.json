{
  "kind": "singleType",
  "collectionName": "contact_floatings",
  "info": {
    "singularName": "contact-floating",
    "pluralName": "contact-floatings",
    "displayName": "Site - Contact Floating",
    "description": "Floating contact widget settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
