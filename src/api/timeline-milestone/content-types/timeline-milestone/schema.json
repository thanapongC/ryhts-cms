{
  "kind": "collectionType",
  "collectionName": "timeline_milestones",
  "info": {
    "singularName": "timeline-milestone",
    "pluralName": "timeline-milestones",
    "displayName": "Timeline Milestone",
    "description": "Company history milestones for About page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "description": "Milestone title"
    },
    "milestone_date": {
      "type": "date",
      "description": "Date of the milestone"
    },
    "description": {
      "type": "text",
      "description": "Description of the milestone"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Optional image for this milestone"
    },
    "about_page": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::about-page.about-page",
      "inversedBy": "timeline_milestones"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Display order (lower number appears first)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Show or hide this milestone on frontend"
    }
  }
}
