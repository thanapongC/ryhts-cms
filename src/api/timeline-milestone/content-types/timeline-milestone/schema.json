{
  "kind": "collectionType",
  "collectionName": "timeline_milestones",
  "info": {
    "singularName": "timeline-milestone",
    "pluralName": "timeline-milestones",
    "displayName": "Timeline Milestone",
    "description": "Company history timeline entries"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "year": {
      "type": "integer",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "date": {
      "type": "date"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "aboutPages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::about-us.about-us"
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
