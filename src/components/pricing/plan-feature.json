{
  "collectionName": "components_pricing_plan_features",
  "info": {
    "displayName": "Plan Feature",
    "icon": "check",
    "description": "Links a pricing feature to a plan with an included/not-included status"
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "feature": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pricing-feature.pricing-feature"
    },
    "included": {
      "type": "boolean",
      "default": true
    },
    "note": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
