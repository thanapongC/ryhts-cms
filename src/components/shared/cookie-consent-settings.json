{
  "collectionName": "components_shared_cookie_consent_settings",
  "info": {
    "displayName": "Cookie Consent Settings",
    "description": "Cookie consent banner labels, descriptions, and action text"
  },
  "attributes": {
    "title": {
      "type": "string",
      "description": "Consent banner heading text"
    },
    "description": {
      "type": "text",
      "description": "Consent banner description text"
    },
    "necessaryLabel": {
      "type": "string",
      "description": "Label for necessary cookies category"
    },
    "necessaryDescription": {
      "type": "text",
      "description": "Description for necessary cookies category"
    },
    "analyticsLabel": {
      "type": "string",
      "description": "Label for analytics cookies category"
    },
    "analyticsDescription": {
      "type": "text",
      "description": "Description for analytics cookies category"
    },
    "marketingLabel": {
      "type": "string",
      "description": "Label for marketing cookies category"
    },
    "marketingDescription": {
      "type": "text",
      "description": "Description for marketing cookies category"
    },
    "acceptAllLabel": {
      "type": "string",
      "default": "Accept All",
      "description": "Accept all cookies button text"
    },
    "rejectAllLabel": {
      "type": "string",
      "default": "Reject All",
      "description": "Reject all cookies button text"
    },
    "manageLabel": {
      "type": "string",
      "default": "Manage Preferences",
      "description": "Manage preferences button text"
    },
    "saveLabel": {
      "type": "string",
      "default": "Save Preferences",
      "description": "Save preferences button text"
    },
    "privacyPolicyLabel": {
      "type": "string",
      "description": "Privacy policy link text"
    },
    "cookiePolicyLabel": {
      "type": "string",
      "description": "Cookie policy link text"
    },
    "alwaysOnLabel": {
      "type": "string",
      "description": "Label for always-on badge on required cookies"
    },
    "learnMoreLabel": {
      "type": "string",
      "description": "Learn more link text"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Show or hide the cookie consent banner"
    }
  }
}
