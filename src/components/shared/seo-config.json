{
  "collectionName": "components_shared_seo_config",
  "info": {
    "displayName": "SEO Config",
    "description": "Site-wide SEO defaults, social profiles, and analytics (used only in Global Setting)"
  },
  "attributes": {
    "siteUrl": {
      "type": "string",
      "description": "Canonical site URL (e.g. https://ryhts.com)"
    },
    "siteName": {
      "type": "string",
      "description": "Site name for structured data and OG"
    },
    "defaultTitle": {
      "type": "string",
      "description": "Default meta title when pages do not provide one"
    },
    "defaultDescription": {
      "type": "text",
      "description": "Default meta description when pages do not provide one"
    },
    "defaultOgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Fallback OG image when pages do not provide one"
    },
    "brandName": {
      "type": "string",
      "description": "Brand name for structured data"
    },
    "facebookUrl": {
      "type": "string",
      "description": "Facebook profile URL"
    },
    "lineUrl": {
      "type": "string",
      "description": "LINE Official Account URL"
    },
    "twitterUrl": {
      "type": "string",
      "description": "Twitter profile URL"
    },
    "googleAnalyticsId": {
      "type": "string",
      "description": "Google Analytics measurement ID"
    },
    "facebookPixelId": {
      "type": "string",
      "description": "Facebook Pixel ID"
    },
    "twitterHandle": {
      "type": "string",
      "description": "Twitter handle for cards"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Enable or disable this SEO config"
    }
  }
}
