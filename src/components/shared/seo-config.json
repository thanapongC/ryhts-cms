{
  "collectionName": "components_shared_seo_configs",
  "info": {
    "displayName": "SEO Config",
    "icon": "globe",
    "description": "Site-wide SEO configuration: site name, defaults, social links"
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteUrl": {
      "type": "string",
      "required": true
    },
    "siteName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "defaultTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "defaultDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "defaultOgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "brandName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "facebookUrl": {
      "type": "string"
    },
    "lineUrl": {
      "type": "string"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "youtubeUrl": {
      "type": "string"
    },
    "twitterHandle": {
      "type": "string"
    },
    "googleAnalyticsId": {
      "type": "string"
    },
    "facebookPixelId": {
      "type": "string"
    },
    "robotsUserAgent": {
      "type": "string",
      "default": "*"
    },
    "robotsAllowPaths": {
      "type": "json"
    },
    "robotsDisallowPaths": {
      "type": "json"
    },
    "robotsSitemapUrl": {
      "type": "string"
    },
    "robotsCrawlDelay": {
      "type": "integer",
      "default": 1
    }
  }
}
