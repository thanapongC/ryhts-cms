{
  "collectionName": "components_navigation_nav_child_items",
  "info": {
    "displayName": "Nav Child Item",
    "icon": "caretRight",
    "description": "A second-level navigation link"
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string"
    },
    "productPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-page.product-page"
    },
    "target": {
      "type": "enumeration",
      "enum": [
        "_self",
        "_blank"
      ],
      "default": "_self"
    }
  }
}
