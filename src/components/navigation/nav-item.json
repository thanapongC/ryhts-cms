{
  "collectionName": "components_navigation_nav_items",
  "info": {
    "displayName": "Nav Item",
    "icon": "caretRight",
    "description": "A single navigation link with optional nested children"
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string",
      "required": true
    },
    "target": {
      "type": "enumeration",
      "enum": [
        "_self",
        "_blank"
      ],
      "default": "_self"
    },
    "children": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.nav-child-item"
    }
  }
}
