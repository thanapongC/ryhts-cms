{
  "collectionName": "components_navigation_footer_section",
  "info": {
    "displayName": "Navigation Footer Section",
    "description": "A column/group of links in the footer navigation"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "description": "Section heading (e.g. Products, Company, Support)"
    },
    "links": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.nav-child-item",
      "description": "Links in this section"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "description": "Display order (lower number appears first)"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Show or hide this footer section"
    }
  }
}
