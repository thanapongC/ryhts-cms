{
  "collectionName": "components_faq_faq_item",
  "info": {
    "displayName": "FAQ Item",
    "description": "A single FAQ question and answer"
  },
  "attributes": {
    "question": {
      "type": "string",
      "required": true,
      "description": "The question text"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "description": "Display order (lower number appears first)"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Show or hide this FAQ item"
    },
    "answer": {
      "type": "richtext",
      "required": true,
      "description": "The answer content"
    }
  }
}
