    },
    "businessHoursLabel": {
      "type": "string",
      "localized": true,
      "description": "Label for the business hours field"
    },
    "phoneLabel": {
      "type": "string",
      "localized": true,
      "description": "Label for the phone field"
    },
    "emailLabel": {
      "type": "string",
      "localized": true,
      "description": "Label for the email field"
    },
    "sortOrder": {
      "type": "integer",
