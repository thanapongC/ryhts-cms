{
  "collectionName": "components_footer_footer_links",
  "info": {
    "displayName": "Footer Link",
    "icon": "link",
    "description": "A footer navigation link. Use either URL or Product Page relation."
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "productPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-page.product-page"
    },
    "url": {
      "type": "string"
    },
    "target": {
      "type": "enumeration",
      "enum": [
        "_self",
        "_blank"
      ],
      "default": "_self"
    }
  }
}
