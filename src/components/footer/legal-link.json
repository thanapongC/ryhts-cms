{
  "collectionName": "components_footer_legal_link",
  "info": {
    "displayName": "Legal Link",
    "description": "Legal page link in the footer (Privacy Policy, Terms, etc.)"
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "description": "Link text (e.g. Privacy Policy, Terms of Service)"
    },
    "url": {
      "type": "string",
      "required": true,
      "description": "Link URL (e.g. /privacy-policy, /terms-of-service)"
    },
    "target": {
      "type": "enumeration",
      "enum": ["_self", "_blank"],
      "default": "_self",
      "description": "Link target (_self or _blank)"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "description": "Display order (lower number appears first)"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Show or hide this legal link"
    }
  }
}
