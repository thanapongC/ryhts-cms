---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeGetAboutPage, getStrapiAbsoluteImageUrl, isPageDisabled } from "../../lib/api";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../lib/i18n";
import OfflineNotice from "../../components/OfflineNotice.astro";
import AboutContent from "../../components/AboutContent.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/about`);

const pageResult = await safeGetAboutPage(lang);

const page = pageResult.data;
if (pageResult.ok && isPageDisabled(page)) return new Response(null, { status: 404 });

const seo = page?.seo;
const isOffline = pageResult.isOffline;
const pageTitle = page?.pageTitle || page?.title || (lang === "en" ? "About Ryhts" : "เกี่ยวกับ Ryhts");
const pageDescription = page?.pageDescription || page?.subtitle || "";

const siteUrl = Astro.url.origin;
---

<BaseLayout
  title={seo?.metaTitle || pageTitle}
  description={seo?.metaDescription || pageDescription}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || getStrapiAbsoluteImageUrl(page?.featuredImage) || undefined}
  robots={seo?.robots}
  keywords={seo?.keywords?.split(",").map((k: string) => k.trim()) || []}
  locale={lang}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/about` },
    { lang: "en", href: `${siteUrl}/en/about` },
    { lang: "x-default", href: `${siteUrl}/th/about` },
  ]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: pageTitle,
    description: seo?.metaDescription || pageDescription,
  }}
>
  <div class="page-header">
    <div class="container">
      <h1>{pageTitle}</h1>
      {pageDescription && <p>{pageDescription}</p>}
    </div>
  </div>

  <section class="section">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`/${lang}/`}>{lang === "en" ? "Home" : "หน้าแรก"}</a>
        <span>/</span>
        <span>{pageTitle}</span>
      </nav>

      {isOffline && (
        <OfflineNotice
          title={lang === "en" ? "Some content unavailable" : "部分内容不可用"}
          message={lang === "en" ? "Some content may be unavailable." : "Some content may be unavailable."}
        />
      )}

      <AboutContent lang={lang} page={page} />
    </div>
  </section>
</BaseLayout>
