---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeGetPrivacyPolicy, getStrapiAbsoluteImageUrl, isPageDisabled } from "../../lib/api";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../lib/i18n";
import OfflineNotice from "../../components/OfflineNotice.astro";
import PrivacyPolicyContent from "../../components/PrivacyPolicyContent.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/pdpa`);

const pdpaResult = await safeGetPrivacyPolicy(lang);
const pdpa = pdpaResult.data;
if (pdpaResult.ok && isPageDisabled(pdpa)) return new Response(null, { status: 404 });
const seo = pdpa?.seo;
const pageTitle = pdpa?.heroTitle || pdpa?.title || (lang === "en" ? "PDPA Policy" : "นโยบายคุ้มครองข้อมูลส่วนบุคคล");
const pageDescription = pdpa?.heroSubtitle || pdpa?.description || "";

const siteUrl = Astro.url.origin;
---

<BaseLayout
  title={seo?.metaTitle || pageTitle}
  description={seo?.metaDescription || pageDescription}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || undefined}
  robots={seo?.robots}
  locale={lang}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/pdpa` },
    { lang: "en", href: `${siteUrl}/en/pdpa` },
    { lang: "x-default", href: `${siteUrl}/th/pdpa` },
  ]}
>
  {pdpaResult.isOffline && !pdpa ? (
    <OfflineNotice
      title={lang === "en" ? "Unable to load" : "ไม่สามารถโหลดได้"}
      message={lang === "en" ? "PDPA content may be unavailable." : "เนื้อหา PDPA อาจไม่พร้อมใช้งานในขณะนี้"}
    />
  ) : (
    <PrivacyPolicyContent lang={lang} policy={pdpa} pageType="privacy" />
  )}
</BaseLayout>
