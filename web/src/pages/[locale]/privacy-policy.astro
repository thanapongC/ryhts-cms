---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeGetPrivacyPolicy, getStrapiAbsoluteImageUrl, isPageDisabled } from "../../lib/api";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../lib/i18n";
import OfflineNotice from "../../components/OfflineNotice.astro";
import PrivacyPolicyContent from "../../components/PrivacyPolicyContent.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/privacy-policy`);

const policyResult = await safeGetPrivacyPolicy(lang);
const policy = policyResult.data;
if (policyResult.ok && isPageDisabled(policy)) return new Response(null, { status: 404 });

const seo = policy?.seo;
const isOffline = policyResult.isOffline;
const pageTitle = policy?.heroTitle || policy?.title || (lang === "en" ? "Privacy Policy" : "นโยบายความเป็นส่วนตัว");
const pageDescription = policy?.heroSubtitle || policy?.description || "";

const siteUrl = Astro.url.origin;
---

<BaseLayout
  title={seo?.metaTitle || pageTitle}
  description={seo?.metaDescription || pageDescription}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || undefined}
  robots={seo?.robots}
  keywords={seo?.keywords?.split(",").map((k: string) => k.trim()) || []}
  locale={lang}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/privacy-policy` },
    { lang: "en", href: `${siteUrl}/en/privacy-policy` },
    { lang: "x-default", href: `${siteUrl}/th/privacy-policy` },
  ]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description: seo?.metaDescription || pageDescription,
  }}
>
  {isOffline && !policy ? (
    <OfflineNotice
      title={lang === "en" ? "Unable to load" : "ไม่สามารถโหลดได้"}
      message={lang === "en" ? "Privacy policy may be unavailable." : "Privacy policy may be unavailable."}
    />
  ) : (
    <PrivacyPolicyContent lang={lang} policy={policy} pageType="privacy" />
  )}
</BaseLayout>
