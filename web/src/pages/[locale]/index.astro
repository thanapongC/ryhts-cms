---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  safeGetFeaturedProducts,
  safeGetGlobalSetting,
  safeGetHomepage,
  getStrapiAbsoluteImageUrl,
  getStrapiMedia,
  normalizeInternalUrl,
  filterAndSort,
  isPageDisabled,
} from "../../lib/api";
import OfflineNotice from "../../components/OfflineNotice.astro";
import SkeletonCard from "../../components/SkeletonCard.astro";
import HeroSection from "../../components/HeroSection.astro";
import FeaturesSection from "../../components/FeaturesSection.astro";
import NewsletterCTA from "../../components/NewsletterCTA.astro";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../lib/i18n";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/`);

const productsResult = await safeGetFeaturedProducts(lang);
const globalResult = await safeGetGlobalSetting(lang);
const homepageResult = await safeGetHomepage(lang);
if (homepageResult.ok && isPageDisabled(homepageResult.data)) return new Response(null, { status: 404 });

const products = productsResult.data;
const globalSetting = globalResult.data;
const homepage = homepageResult.data;
const isOffline = productsResult.isOffline || homepageResult.isOffline;

const seo = homepage?.seo;
const seoConfig = globalSetting?.seoConfig;

const homeProducts = filterAndSort(homepage?.products || []);
const fallbackProducts = products || [];
const displayProducts = homeProducts.length > 0 ? homeProducts : fallbackProducts;
const homeFeatures = filterAndSort(homepage?.features || []).map((feature) => ({
  title: feature.title,
  description: feature.description || "",
}));
const homeBenefits = filterAndSort(homepage?.benefits || []);
const homePricingPlans = filterAndSort(homepage?.pricingPlans || []);
const heroStats = filterAndSort(homepage?.heroStats || []);
const homePrefix = `/${lang}/`;
const heroPrimaryHref = normalizeInternalUrl(homepage?.heroCtaUrl, homePrefix);
const heroSecondaryHref = normalizeInternalUrl(homepage?.heroCta2Url, homePrefix);
const productsHref = `/${lang}/products/`;

function getProductPageHref(slug?: string) {
  return slug ? `/${lang}/products/${slug}/` : productsHref;
}

function getProductPageImage(product: NonNullable<typeof homeProducts[number]>) {
  return getStrapiMedia(product.thumbnail?.url);
}
---

<BaseLayout
  title={seo?.metaTitle || seoConfig?.defaultTitle || homepage?.heroTitle || "RYHTS - Ryhts Ribbon"}
  description={seo?.metaDescription || seoConfig?.defaultDescription || homepage?.heroDescription || "Premier Ribbons for Premier Printing"}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || getStrapiAbsoluteImageUrl(seoConfig?.defaultOgImage) || undefined}
  keywords={seo?.keywords?.split(",").map((keyword) => keyword.trim()) || []}
  locale={lang}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": seo?.schemaType || "WebPage",
    name: seo?.metaTitle || homepage?.heroTitle || "Ryhts Ribbon",
    url: Astro.url.origin,
    description: seo?.metaDescription || homepage?.heroDescription || "Premier Ribbons for Premier Printing",
    publisher: {
      "@type": "Organization",
      name: "Ryhts Ribbon",
      logo: {
        "@type": "ImageObject",
        url: `${Astro.url.origin}/favicon.svg`,
      },
    },
  }}
>
  <HeroSection
    title={homepage?.heroTitle}
    subtitle={homepage?.heroSubtitle}
    description={homepage?.heroDescription}
    primaryCtaText={homepage?.heroCtaText}
    primaryCtaHref={heroPrimaryHref}
    secondaryCtaText={homepage?.heroCta2Text}
    secondaryCtaHref={heroSecondaryHref}
    badgeValue={heroStats[0]?.value}
    badgeLabel={heroStats[0]?.label}
  />

  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom: 48px;">
        <h2 class="section-title">{homepage?.productsTitle || (lang === "en" ? "Best-selling Ryhts Ribbon products" : "รายการสินค้าขายดีของ Ryhts Ribbon")}</h2>
        <p class="section-subtitle">{homepage?.productsSubtitle || (lang === "en" ? "Imported ribbon products with reliable quality and practical support." : "สินค้าริบบอนคุณภาพสูง นำเข้ามาตรฐาน พร้อมให้บริการ")}</p>
      </div>

      {displayProducts.length > 0 ? (
        <div class="homepage-product-grid">
          {displayProducts.map((product) => {
            const imageUrl = getProductPageImage(product);
            return (
              <a href={getProductPageHref(product.slug)} class="homepage-product-card">
                {imageUrl ? (
                  <img src={imageUrl} alt={product.pageTitle || product.name} loading="lazy" />
                ) : (
                  <div class="homepage-product-icon" aria-hidden="true">
                    <i class="fas fa-barcode"></i>
                  </div>
                )}
                <div>
                  <h3>{product.pageTitle || product.name}</h3>
                  <p>{product.shortDesc || product.pageDescription}</p>
                </div>
              </a>
            );
          })}
        </div>
      ) : isOffline && products.length === 0 ? (
        <div>
          <SkeletonCard count={3} variant="product" />
          <OfflineNotice
            title={lang === "en" ? "Unable to load products" : "ไม่สามารถโหลดสินค้าได้"}
            message={lang === "en" ? "Please check your connection and try again." : "กรุณาตรวจสอบการเชื่อมต่อและลองอีกครั้ง"}
          />
        </div>
      ) : (
        <div class="empty-state">
          <i class="fas fa-box-open" style="font-size: 48px; color: var(--color-primary);"></i>
          <p>สินค้ากำลังจะมาเร็วๆ นี้</p>
        </div>
      )}

      <div class="text-center" style="margin-top: 40px;">
        <a href={productsHref} class="btn btn-outline">{lang === "en" ? "View all products" : "ดูสินค้าทั้งหมด"} →</a>
      </div>
    </div>
  </section>

  <FeaturesSection
    title={homepage?.featuresTitle}
    subtitle={homepage?.featuresSubtitle}
    features={homeFeatures.length > 0 ? homeFeatures : undefined}
  />

  {homeBenefits.length > 0 && (
    <section class="section home-benefits">
      <div class="container">
        <div class="text-center" style="margin-bottom: 40px;">
          <h2 class="section-title">{homepage?.benefitsTitle}</h2>
          <p class="section-subtitle">{homepage?.benefitsSubtitle}</p>
        </div>
        <div class="benefits-grid">
          {homeBenefits.map((benefit) => (
            <article class="benefit-card">
              <span class="benefit-icon" aria-hidden="true"><i class="fas fa-check"></i></span>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {(homepage?.videoTitle || homepage?.video || homePricingPlans.length > 0) && (
    <section class="section section-alt home-action-section">
      <div class="container home-action-grid">
        {homepage?.videoTitle && (
          <div class="home-action-panel">
            <span class="panel-kicker">{lang === "en" ? "Guide" : "คู่มือ"}</span>
            <h2>{homepage.videoTitle}</h2>
            <p>{homepage.videoSubtitle || homepage.video?.description}</p>
            {homepage.video?.videoUrl && (
              <a href={homepage.video.videoUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                {lang === "en" ? "Watch video" : "ดูวิดีโอ"} →
              </a>
            )}
          </div>
        )}

        {homePricingPlans.length > 0 && (
          <div class="home-action-panel">
            <span class="panel-kicker">{lang === "en" ? "Quotation" : "ใบเสนอราคา"}</span>
            <h2>{homepage?.pricingTitle || homePricingPlans[0]?.name}</h2>
            <p>{homepage?.pricingSubtitle || homePricingPlans[0]?.description}</p>
            <div class="pricing-teaser">
              <strong>{homePricingPlans[0]?.price}</strong>
              <span>{homePricingPlans[0]?.period}</span>
            </div>
            <a href={normalizeInternalUrl(homePricingPlans[0]?.ctaUrl, homePrefix)} class="btn btn-outline">
              {homePricingPlans[0]?.ctaText || (lang === "en" ? "Contact us" : "ติดต่อเรา")} →
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <NewsletterCTA
    title={homepage?.blogTitle || (lang === "en" ? "Read Ryhts articles and updates" : "อ่านบทความและข่าวสารจาก Ryhts")}
    description={homepage?.blogSubtitle || (lang === "en" ? "Practical guides for ribbon selection and barcode printing." : "คู่มือและคำแนะนำสำหรับการเลือกริบบอนและงานพิมพ์บาร์โค้ด")}
    buttonText={lang === "en" ? "View articles" : "ดูบทความ"}
    buttonHref={`/${lang}/articles/`}
  />
</BaseLayout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .homepage-product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .homepage-product-card,
  .benefit-card,
  .home-action-panel {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .homepage-product-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 100%;
    padding: 24px;
    color: inherit;
    text-decoration: none;
    transition: all var(--transition);
  }
  .homepage-product-card:hover,
  .benefit-card:hover,
  .home-action-panel:hover {
    border-color: var(--color-border-blue);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .homepage-product-card img,
  .homepage-product-icon {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
  }
  .homepage-product-card img {
    object-fit: cover;
  }
  .homepage-product-icon {
    display: grid;
    place-items: center;
    background: var(--color-background-blue);
    color: var(--color-primary);
    font-size: 40px;
  }
  .homepage-product-card h3,
  .benefit-card h3,
  .home-action-panel h2 {
    color: var(--color-text-primary);
    margin-bottom: 10px;
  }
  .homepage-product-card p,
  .benefit-card p,
  .home-action-panel p {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .benefit-card {
    padding: 28px;
    transition: all var(--transition);
  }
  .benefit-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    background: var(--color-background-blue);
    color: var(--color-primary);
  }
  .home-action-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .home-action-panel {
    padding: 32px;
    transition: all var(--transition);
  }
  .panel-kicker {
    display: inline-block;
    margin-bottom: 14px;
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .pricing-teaser {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 18px 0;
  }
  .pricing-teaser strong {
    color: var(--color-primary);
    font-size: 28px;
  }
  .pricing-teaser span {
    color: var(--color-text-muted);
  }
  @media (max-width: 1024px) { .product-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 1024px) {
    .homepage-product-grid,
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .product-grid,
    .homepage-product-grid,
    .benefits-grid,
    .home-action-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
