---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { safeGetArticleBySlug, getStrapiMedia, getStrapiAbsoluteImageUrl } from "../../../lib/api";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../../lib/i18n";
import { getOgImageUrl } from "../../../lib/og";
import { formatDate } from "../../../lib/constants";
import OfflineNotice from "../../../components/OfflineNotice.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/articles/${Astro.params.slug}`);

const { slug } = Astro.params;
const articleResult = await safeGetArticleBySlug(slug as string, lang);
const article = articleResult.data;

if (!article || article.isActive === false) return new Response(null, { status: 404 });

const featuredImage = getStrapiMedia(article.featuredImage?.url);
const seo = article.seo;
const categoryName = typeof article.category === 'string' ? article.category : article.category?.name || "";
const labels = {
  th: {
    articles: "บทความ",
    back: "กลับไปบทความทั้งหมด",
    offlineTitle: "ไม่สามารถโหลดบทความบางส่วนได้",
    offlineMessage: "รายละเอียดบางส่วนอาจไม่พร้อมใช้งานในขณะนี้",
  },
  en: {
    articles: "Articles",
    back: "Back to all articles",
    offlineTitle: "Some article content is unavailable",
    offlineMessage: "Some details may be unavailable right now.",
  },
}[lang];
const dateLocale = lang === "en" ? "en-US" : "th-TH";

type RichTextChild = {
  text?: string;
};

type RichTextBlock = {
  type?: string;
  style?: string;
  level?: number;
  format?: string;
  children?: RichTextChild[];
};

function getBlockText(block: RichTextBlock) {
  return block.children?.map((child) => child.text || "").join("") || "";
}

function getListItems(block: RichTextBlock) {
  return block.children
    ?.map((item) => {
      if ("children" in item && Array.isArray(item.children)) {
        return item.children.map((child: RichTextChild) => child.text || "").join("");
      }
      return item.text || "";
    })
    .filter(Boolean) || [];
}

const contentBlocks = Array.isArray(article.content) ? article.content as RichTextBlock[] : [];
const htmlContent = typeof article.content === "string" ? article.content : "";

const dynamicOgImage = getOgImageUrl({
  baseUrl: Astro.url.origin,
  title: article.title,
  subtitle: article.excerpt || article.author || "",
  type: "article",
  brand: "Ryhts Ribbon",
  category: categoryName,
});

const siteUrl = Astro.url.origin;
---

<BaseLayout
  title={seo?.metaTitle || article.title}
  description={seo?.metaDescription || article.excerpt}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || dynamicOgImage}
  robots={seo?.robots}
  keywords={seo?.keywords?.split(",").map(k => k.trim()) || []}
  locale={lang}
  ogType="article"
  author={article.author}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/articles/${slug}` },
    { lang: "en", href: `${siteUrl}/en/articles/${slug}` },
    { lang: "x-default", href: `${siteUrl}/th/articles/${slug}` },
  ]}
  article={{ publishedTime: article.publishedAt, author: article.author, section: categoryName, tags: article.tags }}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    description: article.excerpt,
    image: featuredImage || undefined,
    author: article.author ? { "@type": "Person", name: article.author } : undefined,
    datePublished: article.publishedAt || undefined,
  }}
>
  <PageHeader title={article.title} />

  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: labels.articles, href: `/${lang}/articles/` }, { label: article.title }]} />

      {articleResult.isOffline && <OfflineNotice title={labels.offlineTitle} message={labels.offlineMessage} />}

      <article class="article-detail">
        <div class="article-meta-bar">
          {article.author && <span class="meta-item"><i class="fas fa-user"></i> {article.author}</span>}
          {article.publishedAt && <span class="meta-item"><i class="fas fa-calendar"></i> {formatDate(article.publishedAt, dateLocale)}</span>}
        </div>

        {featuredImage && <div class="article-featured-image"><img src={featuredImage} alt={article.title} /></div>}

        {contentBlocks.length > 0 ? (
          <div class="rich-text article-content">
            {contentBlocks.map((block) => {
              const type = block.type || block.style || "paragraph";
              const text = getBlockText(block);

              if (!text && type !== "list") return null;
              if (type === "heading") {
                return block.level && block.level <= 2 ? <h2>{text}</h2> : <h3>{text}</h3>;
              }
              if (type === "quote") return <blockquote>{text}</blockquote>;
              if (type === "list") {
                const items = getListItems(block);
                return block.format === "ordered" ? (
                  <ol>{items.map((item) => <li>{item}</li>)}</ol>
                ) : (
                  <ul>{items.map((item) => <li>{item}</li>)}</ul>
                );
              }
              return <p>{text}</p>;
            })}
          </div>
        ) : htmlContent ? (
          <div class="rich-text article-content" set:html={htmlContent} />
        ) : article.excerpt ? (
          <p class="article-content-fallback">{article.excerpt}</p>
        ) : null}

        {article.tags?.length > 0 && (
          <div class="article-tags">
            <i class="fas fa-tags"></i>
            {article.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </article>

      <div class="article-nav">
        <a href={`/${lang}/articles/`} class="btn btn-outline">← {labels.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-detail { max-width: 800px; margin: 0 auto; }
  .article-meta-bar { display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; font-size: 14px; color: var(--color-text-secondary); }
  .meta-item i { color: var(--color-primary); margin-right: 6px; }
  .article-featured-image { border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 32px; }
  .article-featured-image img { width: 100%; max-height: 480px; object-fit: cover; }
  .article-content { color: var(--color-text-secondary); font-size: 17px; line-height: 1.85; }
  .article-content :global(h2), .article-content :global(h3) { color: var(--color-text-primary); line-height: 1.35; margin: 32px 0 14px; }
  .article-content :global(h2) { font-size: clamp(1.5rem, 2vw, 2rem); }
  .article-content :global(h3) { font-size: clamp(1.25rem, 1.6vw, 1.5rem); }
  .article-content :global(p) { margin: 0 0 20px; }
  .article-content :global(ul), .article-content :global(ol) { margin: 0 0 24px; padding-left: 1.4rem; }
  .article-content :global(li) { margin-bottom: 10px; }
  .article-content :global(blockquote) { margin: 28px 0; padding: 20px 24px; border-left: 4px solid var(--color-primary); background: var(--color-background-blue); border-radius: var(--radius-md); color: var(--color-text-primary); }
  .article-content-fallback { max-width: 720px; color: var(--color-text-secondary); font-size: 17px; line-height: 1.8; }
  .article-tags { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid var(--color-border); }
  .tag { padding: 4px 12px; background: var(--color-bg-light); border-radius: 16px; font-size: 13px; color: var(--color-text-secondary); }
  .article-nav { margin-top: 40px; text-align: center; }
</style>
