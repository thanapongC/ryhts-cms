---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeGetContactPage, getStrapiAbsoluteImageUrl } from "../../lib/api";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../lib/i18n";
import OfflineNotice from "../../components/OfflineNotice.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ContactForm from "../../components/ContactForm.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/contact`);

const pageResult = await safeGetContactPage(lang);

const page = pageResult.data;

const contactTitle = page?.title || "ติดต่อเรา";
const seo = page?.seo;
const isOffline = pageResult.isOffline;

const siteUrl = Astro.url.origin;
---

<BaseLayout
  title={seo?.metaTitle || "Contact Us"}
  description={seo?.metaDescription || "ติดต่อ Ryhts Ribbon"}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || undefined}
  robots={seo?.robots}
  keywords={seo?.keywords?.split(",").map(k => k.trim()) || []}
  locale={lang}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/contact` },
    { lang: "en", href: `${siteUrl}/en/contact` },
    { lang: "x-default", href: `${siteUrl}/th/contact` },
  ]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: contactTitle,
    description: seo?.metaDescription || "",
  }}
>
  <PageHeader title={contactTitle} description={seo?.metaDescription} />

  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "Contact Us" }]} />

      {isOffline && (
        <OfflineNotice title="部分内容不可用" message="Some contact information may be unavailable." />
      )}

      <div class="contact-grid">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: 48px; margin-bottom: 48px; }
</style>
