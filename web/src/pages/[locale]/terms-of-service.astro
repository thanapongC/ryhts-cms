---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeGetTermsOfService, getStrapiAbsoluteImageUrl, isPageDisabled } from "../../lib/api";
import { isValidLocale, DEFAULT_LOCALE, type Locale } from "../../lib/i18n";
import OfflineNotice from "../../components/OfflineNotice.astro";
import PrivacyPolicyContent from "../../components/PrivacyPolicyContent.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/terms-of-service`);

const tosResult = await safeGetTermsOfService(lang);
const tos = tosResult.data;
if (tosResult.ok && isPageDisabled(tos)) return new Response(null, { status: 404 });
const seo = tos?.seo;
const pageTitle = tos?.heroTitle || tos?.title || (lang === "en" ? "Terms of Service" : "ข้อกำหนดการใช้บริการ");
const pageDescription = tos?.heroSubtitle || tos?.description || "";

const siteUrl = Astro.url.origin;
---

<BaseLayout
  title={seo?.metaTitle || pageTitle}
  description={seo?.metaDescription || pageDescription}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || undefined}
  robots={seo?.robots}
  locale={lang}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/terms-of-service` },
    { lang: "en", href: `${siteUrl}/en/terms-of-service` },
    { lang: "x-default", href: `${siteUrl}/th/terms-of-service` },
  ]}
>
  {tosResult.isOffline && !tos ? (
    <OfflineNotice
      title={lang === "en" ? "Unable to load" : "ไม่สามารถโหลดได้"}
      message={lang === "en" ? "Terms may be unavailable." : "ข้อกำหนดอาจไม่พร้อมใช้งานในขณะนี้"}
    />
  ) : (
    <PrivacyPolicyContent lang={lang} policy={tos} pageType="terms" />
  )}
</BaseLayout>
