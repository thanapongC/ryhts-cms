---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterAndSort, getStrapiAbsoluteImageUrl, safeGetCookiePolicy, isPageDisabled } from "../../lib/api";
import { DEFAULT_LOCALE, isValidLocale, type Locale } from "../../lib/i18n";
import Breadcrumb from "../../components/Breadcrumb.astro";
import OfflineNotice from "../../components/OfflineNotice.astro";

const lang = (Astro.params.locale as Locale) || DEFAULT_LOCALE;
if (!isValidLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/cookie-policy`);

const policyResult = await safeGetCookiePolicy(lang);
const policy = policyResult.data;
if (policyResult.ok && isPageDisabled(policy)) return new Response(null, { status: 404 });
const seo = policy?.seo;
const categories = filterAndSort(policy?.categories);
const sections = filterAndSort(policy?.sections);

const labels = {
  th: {
    home: "หน้าแรก",
    fallbackTitle: "นโยบายคุกกี้",
    lastUpdated: "อัปเดตล่าสุด",
    contents: "รายละเอียด",
    manage: "ตั้งค่าคุกกี้",
    offlineTitle: "ไม่สามารถโหลดนโยบายคุกกี้บางส่วนได้",
    offlineMessage: "รายละเอียดบางส่วนอาจไม่พร้อมใช้งานในขณะนี้",
    empty: "เนื้อหานโยบายคุกกี้ยังไม่พร้อมใช้งาน",
  },
  en: {
    home: "Home",
    fallbackTitle: "Cookie Policy",
    lastUpdated: "Last updated",
    contents: "Details",
    manage: "Cookie Preferences",
    offlineTitle: "Some cookie policy content is unavailable",
    offlineMessage: "Some details may be unavailable right now.",
    empty: "Cookie policy content is not yet available.",
  },
}[lang];

const pageTitle = policy?.heroTitle || policy?.title || labels.fallbackTitle;
const pageDescription = policy?.heroSubtitle || policy?.description || "";
const siteUrl = Astro.url.origin;

function iconClass(icon?: string) {
  const map: Record<string, string> = {
    shield: "fa-shield-halved",
    settings: "fa-sliders",
    analytics: "fa-chart-line",
    marketing: "fa-bullhorn",
  };
  return map[icon || ""] || "fa-cookie-bite";
}
---

<BaseLayout
  title={seo?.metaTitle || pageTitle}
  description={seo?.metaDescription || pageDescription}
  ogImage={getStrapiAbsoluteImageUrl(seo?.ogImage) || undefined}
  robots={seo?.robots}
  keywords={seo?.keywords?.split(",").map((keyword: string) => keyword.trim()) || []}
  locale={lang}
  hreflangs={[
    { lang: "th", href: `${siteUrl}/th/cookie-policy` },
    { lang: "en", href: `${siteUrl}/en/cookie-policy` },
    { lang: "x-default", href: `${siteUrl}/th/cookie-policy` },
  ]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": seo?.schemaType || "WebPage",
    name: pageTitle,
    description: seo?.metaDescription || pageDescription,
  }}
>
  <section class="cookie-policy-hero">
    <div class="container">
      {policy?.heroBadge && <span class="eyebrow">{policy.heroBadge}</span>}
      <h1>{pageTitle}</h1>
      {pageDescription && <p>{pageDescription}</p>}
      {policy?.lastUpdated && (
        <div class="last-updated">{labels.lastUpdated}: {policy.lastUpdated}</div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: labels.home, href: `/${lang}/` }, { label: pageTitle }]} />

      {policyResult.isOffline && (
        <OfflineNotice title={labels.offlineTitle} message={labels.offlineMessage} />
      )}

      {categories.length > 0 && (
        <section class="cookie-category-section">
          {policy?.categoriesBadge && <span class="section-eyebrow">{policy.categoriesBadge}</span>}
          <div class="section-heading">
            <h2>{policy?.categoriesTitle || (lang === "en" ? "Cookies We Use" : "คุกกี้ที่เราใช้")}</h2>
            {policy?.categoriesDescription && <p>{policy.categoriesDescription}</p>}
          </div>
          <div class="category-grid">
            {categories.map((category) => (
              <article class={`category-card is-${category.accent || "orange"}`}>
                <div class="category-icon">
                  <i class={`fas ${iconClass(category.icon)}`}></i>
                </div>
                <h3>{category.title}</h3>
                {category.description && <p>{category.description}</p>}
              </article>
            ))}
          </div>
        </section>
      )}

      {sections.length > 0 ? (
        <section class="policy-details">
          <h2>{labels.contents}</h2>
          {sections.map((section) => (
            <article class="policy-section" id={section.slug || undefined}>
              <h3>{section.title}</h3>
              {section.summary && <p class="section-summary">{section.summary}</p>}
              <div class="rich-text" set:html={section.content} />
            </article>
          ))}
        </section>
      ) : policy?.content ? (
        <div class="policy-details">
          <div class="rich-text" set:html={policy.content} />
        </div>
      ) : (
        <p class="empty-state">{labels.empty}</p>
      )}

      <section class="manage-panel">
        <div>
          <h2>{policy?.manageTitle || labels.manage}</h2>
          {policy?.manageDescription && <p>{policy.manageDescription}</p>}
        </div>
        <button class="btn btn-primary" data-cookie-manage type="button">
          {policy?.manageButtonLabel || labels.manage}
        </button>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .cookie-policy-hero {
    padding: 140px 0 64px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #FFFFFF;
    text-align: center;
  }

  .cookie-policy-hero h1 {
    max-width: 820px;
    margin: 0 auto 14px;
    color: #FFFFFF;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .cookie-policy-hero p {
    max-width: 760px;
    margin: 0 auto;
    color: #E0F2FE;
    line-height: 1.75;
  }

  .eyebrow,
  .section-eyebrow {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 14px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
  }

  .eyebrow {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #FFFFFF;
  }

  .section-eyebrow {
    background: var(--color-background-blue);
    color: var(--color-primary);
  }

  .last-updated {
    margin-top: 18px;
    color: #E0F2FE;
    font-size: 14px;
  }

  .cookie-category-section,
  .policy-details,
  .manage-panel {
    margin-top: 40px;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 24px;
  }

  .section-heading h2,
  .policy-details h2,
  .manage-panel h2 {
    color: var(--color-text-primary);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .section-heading p,
  .manage-panel p,
  .section-summary {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .category-card {
    min-height: 220px;
    padding: 24px;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    background: #FFFFFF;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
  }

  .category-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
    border-radius: 14px;
    background: var(--color-background-blue);
    color: var(--color-primary);
  }

  .category-card.is-red .category-icon {
    background: #FEF2F2;
    color: #DC2626;
  }

  .category-card h3 {
    color: var(--color-text-primary);
    font-size: 18px;
    margin-bottom: 10px;
  }

  .category-card p,
  .policy-section .rich-text {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .policy-details {
    max-width: 880px;
  }

  .policy-section {
    padding: 28px 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .policy-section h3 {
    margin-bottom: 10px;
    color: var(--color-text-primary);
    font-size: 22px;
  }

  .manage-panel {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--color-background-blue);
  }

  .empty-state {
    color: var(--color-text-secondary);
  }

  @media (max-width: 960px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cookie-policy-hero {
      padding: 120px 0 48px;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .manage-panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
