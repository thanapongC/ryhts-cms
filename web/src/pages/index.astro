---
import BaseLayout from "../layouts/BaseLayout.astro";
import { safeGetFeaturedProducts, safeGetCompanyInfo, getStrapiMedia } from "../lib/api";
import OfflineNotice from "../components/OfflineNotice.astro";
import SkeletonCard from "../components/SkeletonCard.astro";

import { safeGetGlobalSetting } from "../lib/api";

const productsResult = await safeGetFeaturedProducts("th");
const companyResult = await safeGetCompanyInfo("th");
const globalResult = await safeGetGlobalSetting("th");

const products = productsResult.data;
const companyInfo = companyResult.data;
const globalSetting = globalResult.data;
const isOffline = productsResult.isOffline;

const ribbonTypeLabels: Record<string, string> = {
  wax: "Ribbon Wax",
  wax_resin: "Ribbon Wax-Resin",
  resin: "Ribbon Resin",
};

const ribbonTypeBadgeClass: Record<string, string> = {
  wax: "badge-wax",
  wax_resin: "badge-wax-resin",
  resin: "badge-resin",
};
---

<BaseLayout
  title={globalSetting?.meta_title || "RYHTS - Ryhts Ribbon"}
  description={globalSetting?.meta_description || "Premier Ribbons for Premier Printing"}
  ogImage={globalSetting?.og_image?.url}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Ryhts Ribbon",
    url: Astro.url.origin,
    description: "Premier Ribbons for Premier Printing",
    publisher: {
      "@type": "Organization",
      name: "Ryhts Ribbon",
      logo: {
        "@type": "ImageObject",
        url: `${Astro.url.origin}/favicon.svg`,
      },
    },
  }}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <h1>Premier Ribbon for Premier Printing</h1>
        <p>
          ไรต์ส (ryhts) เราคือผู้จำหน่ายริบบอนหรือผ้าหมึกพิมพ์สำหรับใช้กับเครื่องพิมพ์บาร์โค้ดทุกขนาด
          มีให้ท่านเลือกใช้หลากหลายแบบ เรามุ่งมั่นที่จะพัฒนาสินค้านำเข้าที่ได้มาตรฐาน
        </p>
        <div class="hero-actions">
          <a href="/products" class="btn btn-primary btn-lg">ดูสินค้าทั้งหมด</a>
          <a href="/about" class="btn btn-outline btn-lg">รู้จัก Ryhts</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-shape"></div>
        <div class="hero-badge">
          <span class="hero-badge-number">{companyInfo?.customer_count || "100"}+</span>
          <span class="hero-badge-text">ลูกค้าที่ไว้วางใจ</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom: 48px;">
        <h2 class="section-title">รายการสินค้าขายดีของ Ryhts Ribbon</h2>
        <p class="section-subtitle">สินค้าริบบอนคุณภาพสูง นำเข้ามาตรฐาน พร้อมให้บริการ</p>
      </div>

      {isOffline && products.length === 0 ? (
        <div>
          <SkeletonCard count={3} variant="product" />
          <OfflineNotice
            title="ไม่สามารถโหลดสินค้าได้"
            message="Unable to load products from the server. Please check your internet connection."
          />
        </div>
      ) : products.length > 0 ? (
        <div class="product-grid">
          {products.map((product) => {
            const imageUrl = getStrapiMedia(product.images?.[0]?.url);
            return (
              <a href={`/products/${product.slug}`} class="product-card">
                {imageUrl && (
                  <div class="product-card-image">
                    <img src={imageUrl} alt={product.title} loading="lazy" />
                  </div>
                )}
                <div class="product-card-body">
                  <div class="product-card-meta">
                    <span class={`badge ${ribbonTypeBadgeClass[product.ribbon_type] || "badge-primary"}`}>
                      {ribbonTypeLabels[product.ribbon_type] || product.ribbon_type}
                    </span>
                    {product.brand && <span class="product-brand">{product.brand.name}</span>}
                  </div>
                  <h3>{product.title}</h3>
                  <p class="product-excerpt">{product.short_description}</p>
                  <span class="product-link">อ่านรายละเอียด →</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">
          <i class="fas fa-box-open" style="font-size: 48px; color: var(--color-primary);"></i>
          <p>สินค้ากำลังจะมาเร็วๆ นี้</p>
        </div>
      )}

      <div class="text-center" style="margin-top: 40px;">
        <a href="/products" class="btn btn-outline">ดูสินค้าทั้งหมด →</a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section section-alt">
    <div class="container">
      <div class="text-center" style="margin-bottom: 48px;">
        <h2 class="section-title">ทำไมต้องเลือก Ryhts</h2>
        <p class="section-subtitle">มุ่งมั่นพัฒนาสินค้านำเข้าที่ได้มาตรฐาน และให้บริการที่ตอบโจทย์</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-award"></i>
          </div>
          <h3>คุณภาพมาตรฐาน</h3>
          <p>สินค้านำเข้าที่ได้มาตรฐาน ผ่านการทดสอบคุณภาพทุกชิ้น</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-truck-fast"></i>
          </div>
          <h3>จัดส่งรวดเร็ว</h3>
          <p>บริการจัดส่งทั่วประเทศ สะดวกและรวดเร็ว</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-headset"></i>
          </div>
          <h3>บริการหลังการขาย</h3>
          <p>ทีมงานพร้อมให้คำปรึกษาและช่วยเหลือทุกปัญหา</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <i class="fas fa-tags"></i>
          </div>
          <h3>ราคาคุ้มค่า</h3>
          <p>ราคาโรงงาน พร้อมส่วนลดสำหรับลูกค้าองค์กร</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="newsletter-section">
    <div class="container newsletter-inner">
      <div class="newsletter-content">
        <h2>กดรับสมัครข่าวสารจากเรา</h2>
        <p>สมัครรับข่าวสารและติดตามสินค้าออกใหม่</p>
      </div>
      <div class="newsletter-cta">
        <a href="/contact" class="btn btn-white btn-lg">ติดต่อเรา</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ──────────────────────────────────────────────────────── */
  .hero {
    padding: 140px 0 80px;
    background: linear-gradient(135deg, #f8fbff 0%, #e8f4fd 100%);
    min-height: 520px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content h1 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--color-text);
  }

  .hero-content p {
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-shape {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary) 0%, #0160b0 100%);
    opacity: 0.1;
    position: absolute;
  }

  .hero-badge {
    position: relative;
    z-index: 1;
    text-align: center;
    background: #fff;
    padding: 40px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .hero-badge-number {
    display: block;
    font-size: 56px;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .hero-badge-text {
    display: block;
    font-size: 16px;
    color: var(--color-text-secondary);
    margin-top: 8px;
  }

  /* ─── Product Grid ──────────────────────────────────────────────── */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .product-card {
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all var(--transition);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .product-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card-image img {
    transform: scale(1.05);
  }

  .product-card-body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .product-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .badge-wax {
    background: #fef3c7;
    color: #b45309;
  }

  .badge-wax-resin {
    background: #dbeafe;
    color: #1e40af;
  }

  .badge-resin {
    background: #dcfce7;
    color: #166534;
  }

  .product-brand {
    font-size: 12px;
    color: var(--color-text-light);
  }

  .product-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .product-excerpt {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-primary);
  }

  /* ─── Features ──────────────────────────────────────────────────── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .feature-card {
    text-align: center;
    padding: 32px 24px;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    transition: all var(--transition);
  }

  .feature-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .feature-icon i {
    font-size: 24px;
    color: var(--color-primary);
  }

  .feature-card h3 {
    font-size: 17px;
    margin-bottom: 10px;
  }

  .feature-card p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ─── Newsletter ────────────────────────────────────────────────── */
  .newsletter-section {
    background: var(--color-primary);
    padding: 60px 0;
  }

  .newsletter-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .newsletter-content h2 {
    font-size: 28px;
    color: #fff;
    margin-bottom: 8px;
  }

  .newsletter-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 16px;
  }

  /* ─── Responsive ────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 120px 0 60px;
      min-height: auto;
    }

    .hero-content h1 {
      font-size: 32px;
    }

    .product-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .newsletter-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
