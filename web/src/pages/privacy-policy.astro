---
import BaseLayout from "../layouts/BaseLayout.astro";
import { safeGetPrivacyPolicy } from "../lib/api";
import OfflineNotice from "../components/OfflineNotice.astro";

const policyResult = await safeGetPrivacyPolicy("th");
const policy = policyResult.data;

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString("th-TH", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title={policy?.meta_title || "Privacy Policy"}
  description={policy?.meta_description || "Privacy Policy of Ryhts Ribbon"}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: policy?.title || "Privacy Policy",
    description: policy?.meta_description || "",
    dateModified: policy?.last_updated || undefined,
  }}
>
  <div class="page-header">
    <div class="container">
      <h1>{policy?.title || "Privacy Policy"}</h1>
      {policy?.last_updated && (
        <p>Last updated: {formatDate(policy.last_updated)}</p>
      )}
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Privacy Policy</span>
      </div>

      {policyResult.isOffline && (
        <OfflineNotice
          title="部分内容不可用"
          message="Privacy policy content may be unavailable due to a connection issue."
        />
      )}

      <div class="policy-content">
        {policy?.description && (
          <p class="policy-summary">{policy.description}</p>
        )}

        {policy?.content ? (
          <div class="rich-text" set:html={policy.content} />
        ) : (
          <div class="rich-text">
            <p>Privacy policy content is not yet available. Please check back later.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-content {
    max-width: 800px;
  }

  .policy-summary {
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
    padding: 20px;
    background: var(--color-bg-light);
    border-radius: var(--radius);
  }
</style>
