---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeGetProducts, safeGetCategories, getStrapiMedia } from "../../lib/api";
import OfflineNotice from "../../components/OfflineNotice.astro";

const productsResult = await safeGetProducts("th", 1, 12);
const categoriesResult = await safeGetCategories("th");

const products = productsResult.data?.data || [];
const categories = categoriesResult.data || [];
const isOffline = productsResult.isOffline;

const ribbonTypeLabels: Record<string, string> = {
  wax: "Ribbon Wax",
  wax_resin: "Ribbon Wax-Resin",
  resin: "Ribbon Resin",
};

const ribbonTypeBadgeClass: Record<string, string> = {
  wax: "badge-wax",
  wax_resin: "badge-wax-resin",
  resin: "badge-resin",
};
---

<BaseLayout
  title="Products"
  description="สินค้าริบบอนสำหรับเครื่องพิมพ์บาร์โค้ดทุกขนาด หลากหลายประเภทให้เลือกใช้"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Products",
    description: "สินค้าริบบอนสำหรับเครื่องพิมพ์บาร์โค้ดทุกขนาด",
  }}
>
  <div class="page-header">
    <div class="container">
      <h1>สินค้าของเรา</h1>
      <p>ริบบอนสำหรับเครื่องพิมพ์บาร์โค้ดทุกขนาด หลากหลายประเภทให้เลือกใช้</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Products</span>
      </div>

      <!-- Category Filters -->
      {categories.length > 0 && (
        <div class="category-filters">
          <a href="/products" class:list={["filter-btn", { active: true }]}>ทั้งหมด</a>
          {categories.map((cat) => (
            <a href={`/products?category=${cat.slug}`} class="filter-btn">{cat.name}</a>
          ))}
        </div>
      )}

      <!-- Products Grid -->
      {isOffline && products.length === 0 ? (
        <OfflineNotice
          title="ไม่สามารถโหลดสินค้าได้"
          message="Unable to load products. Please check your connection and try again."
        />
      ) : products.length > 0 ? (
        <div class="products-grid">
          {products.map((product) => {
            const imageUrl = getStrapiMedia(product.images?.[0]?.url);
            return (
              <a href={`/products/${product.slug}`} class="product-card">
                {imageUrl && (
                  <div class="product-card-image">
                    <img src={imageUrl} alt={product.title} loading="lazy" />
                  </div>
                )}
                <div class="product-card-body">
                  <div class="product-card-meta">
                    <span class={`badge ${ribbonTypeBadgeClass[product.ribbon_type] || "badge-primary"}`}>
                      {ribbonTypeLabels[product.ribbon_type] || product.ribbon_type}
                    </span>
                    {product.brand && <span class="product-brand">{product.brand.name}</span>}
                  </div>
                  <h3>{product.title}</h3>
                  <p class="product-excerpt">{product.short_description}</p>
                  <span class="product-link">อ่านรายละเอียด →</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">
          <i class="fas fa-box-open" style="font-size: 48px; color: var(--color-primary);"></i>
          <p>ยังไม่มีสินค้าในขณะนี้</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .category-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .filter-btn {
    padding: 8px 20px;
    border-radius: 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-bg-light);
    text-decoration: none;
    transition: all var(--transition);
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-primary);
    color: #fff;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .product-card {
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all var(--transition);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .product-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card-image img {
    transform: scale(1.05);
  }

  .product-card-body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .product-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .badge-wax {
    background: #fef3c7;
    color: #b45309;
  }

  .badge-wax-resin {
    background: #dbeafe;
    color: #1e40af;
  }

  .badge-resin {
    background: #dcfce7;
    color: #166534;
  }

  .product-brand {
    font-size: 12px;
    color: var(--color-text-light);
  }

  .product-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .product-excerpt {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
