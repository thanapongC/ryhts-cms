---
import BaseLayout from "../layouts/BaseLayout.astro";
import { safeGetTermsOfService } from "../lib/api";
import OfflineNotice from "../components/OfflineNotice.astro";

const tosResult = await safeGetTermsOfService("th");
const tos = tosResult.data;

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString("th-TH", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title={tos?.meta_title || "Terms of Service"}
  description={tos?.meta_description || "Terms of Service of Ryhts Ribbon"}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: tos?.title || "Terms of Service",
    description: tos?.meta_description || "",
    dateModified: tos?.last_updated || undefined,
  }}
>
  <div class="page-header">
    <div class="container">
      <h1>{tos?.title || "Terms of Service"}</h1>
      {tos?.last_updated && (
        <p>Last updated: {formatDate(tos.last_updated)}</p>
      )}
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Terms of Service</span>
      </div>

      {tosResult.isOffline && (
        <OfflineNotice
          title="部分内容不可用"
          message="Terms of Service content may be unavailable due to a connection issue."
        />
      )}

      <div class="policy-content">
        {tos?.description && (
          <p class="policy-summary">{tos.description}</p>
        )}

        {tos?.content ? (
          <div class="rich-text" set:html={tos.content} />
        ) : (
          <div class="rich-text">
            <p>Terms of Service content is not yet available. Please check back later.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-content {
    max-width: 800px;
  }

  .policy-summary {
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
    padding: 20px;
    background: var(--color-bg-light);
    border-radius: var(--radius);
  }
</style>
