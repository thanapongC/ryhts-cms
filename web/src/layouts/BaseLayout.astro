---
import { safeGetSiteSetting, safeGetFooterSetting, getStrapiMedia } from "../lib/api";
import { detectLocale, type Locale } from "../lib/i18n";
import ErrorBanner from "../components/ErrorBanner.astro";
import CookieConsent from "../components/CookieConsent.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import SeoHead from "../components/SeoHead.astro";

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

interface ProductMeta {
  price?: string;
  currency?: string;
  availability?: string;
  brand?: string;
}

interface Hreflang {
  lang: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  ogType?: "website" | "article" | "product";
  robots?: string;
  author?: string;
  keywords?: string[];
  themeColor?: string;
  locale?: string;
  twitterSite?: string;
  twitterCreator?: string;
  facebookAppId?: string;
  hreflangs?: Hreflang[];
  article?: ArticleMeta;
  product?: ProductMeta;
  ogVideo?: string;
  ogAudio?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  canonical,
  ogType,
  robots,
  author,
  keywords,
  themeColor,
  locale: propLocale,
  twitterSite,
  twitterCreator,
  facebookAppId,
  hreflangs,
  article,
  product,
  ogVideo,
  ogAudio,
  jsonLd,
} = Astro.props;

// Detect locale: prop > cookie > Accept-Language > default
const cookieHeader = Astro.request.headers.get("cookie") || undefined;
const acceptLanguage = Astro.request.headers.get("accept-language") || undefined;
const detectedLocale = detectLocale(cookieHeader, acceptLanguage);
const locale = propLocale || detectedLocale;

const siteResult = await safeGetSiteSetting(locale);
const footerResult = await safeGetFooterSetting(locale);

const siteSetting = siteResult.data;
const footerSetting = footerResult.data;
const isOffline = siteResult.isOffline || footerResult.isOffline;

const siteName = siteSetting?.site_name || "RYHTS";
const siteDescription = siteSetting?.site_description || "Premier Ribbons for Premier Printing";
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const metaDescription = description || siteDescription;
const logoUrl = getStrapiMedia(siteSetting?.site_logo?.url);

// Default OG image from site settings if not provided by page
const defaultOgImage = siteSetting?.og_image?.url || siteSetting?.site_logo?.url || "/og-default.svg";
const resolvedOgImage = ogImage || defaultOgImage;

const navItems = [
  { label: "Home", href: "/" },
  { label: "About us", href: "/about" },
  { label: "Products", href: "/products" },
  { label: "Articles", href: "/articles" },
  { label: "Contact us", href: "/contact" },
];

const socialLinks = footerSetting?.social_links || {};
const copyrightText = footerSetting?.copyright_text || `© ${new Date().getFullYear()} Ryhts Ribbon. All rights reserved.`;

// Generate hreflang tags for multilingual support
// Current site supports: th (Thai), en (English)
const currentPath = Astro.url.pathname;
const siteOrigin = Astro.url.origin;

// Helper to build language-specific URL
function getLanguageUrl(lang: string): string {
  // For now, since we only have th locale, en would be a future implementation
  // This structure allows easy expansion when en locale is added
  if (lang === "en") {
    // Future: return `${siteOrigin}/en${currentPath}`;
    return `${siteOrigin}${currentPath}`; // Fallback to current for now
  }
  return `${siteOrigin}${currentPath}`;
}

// Default hreflangs if not provided by page
const defaultHreflangs: Hreflang[] = [
  { lang: "th", href: getLanguageUrl("th") },
  { lang: "en", href: getLanguageUrl("en") },
  { lang: "x-default", href: getLanguageUrl("th") }, // Default to Thai
];

const resolvedHreflangs = hreflangs || defaultHreflangs;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={pageTitle}
      description={metaDescription}
      ogImage={resolvedOgImage}
      ogImageAlt={ogImageAlt}
      canonical={canonical}
      ogType={ogType}
      robots={robots}
      author={author}
      keywords={keywords}
      themeColor={themeColor}
      twitterSite={twitterSite}
      twitterCreator={twitterCreator}
      facebookAppId={facebookAppId}
      hreflangs={resolvedHreflangs}
      article={article}
      product={product}
      ogVideo={ogVideo}
      ogAudio={ogAudio}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body>
    <!-- Offline Banner -->
    {isOffline && <ErrorBanner message="Unable to connect to the server. Some content may be outdated." />}

    <!-- Header -->
    <header class:list={["site-header", { "has-banner": isOffline }]} id="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          {logoUrl ? (
            <img src={logoUrl} alt={siteName} height="40" />
          ) : (
            <span class="logo-text">{siteName}</span>
          )}
        </a>

        <nav class="main-nav" id="main-nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["nav-link", { active: Astro.url.pathname === item.href || (item.href !== "/" && Astro.url.pathname.startsWith(item.href)) }]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-right">
          <LanguageSwitcher currentLocale={locale} />
          <SearchOverlay />
          {siteSetting?.phone && (
            <a href={`tel:${siteSetting.phone}`} class="header-phone">
              <i class="fas fa-phone"></i>
              <span>{siteSetting.phone}</span>
            </a>
          )}
          <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div class="mobile-nav" id="mobile-nav">
        <div class="mobile-nav-header">
          <span class="logo-text">{siteName}</span>
          <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <nav class="mobile-nav-links">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["mobile-nav-link", { active: Astro.url.pathname === item.href }]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        {siteSetting?.phone && (
          <a href={`tel:${siteSetting.phone}`} class="mobile-nav-phone">
            <i class="fas fa-phone"></i> {siteSetting.phone}
          </a>
        )}
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <!-- Company Info -->
          <div class="footer-col">
            <h4>ติดต่อฝ่ายขาย Ryhts</h4>
            <div class="footer-contact">
              {siteSetting?.phone && (
                <p><a href={`tel:${siteSetting.phone}`}><i class="fas fa-phone"></i> {siteSetting.phone}</a></p>
              )}
              {siteSetting?.email && (
                <p><a href={`mailto:${siteSetting.email}`}><i class="fas fa-envelope"></i> {siteSetting.email}</a></p>
              )}
            </div>
          </div>

          <!-- Links -->
          <div class="footer-col">
            <h4>Links</h4>
            <ul class="footer-links">
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
              <li><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/pdpa">PDPA</a></li>
              <li><a href="/terms-of-service">Terms of Service</a></li>
              <li><a href="#" data-cookie-manage>Manage Cookies</a></li>
            </ul>
          </div>

          <!-- About -->
          <div class="footer-col">
            <div class="footer-about">
              {logoUrl && <img src={logoUrl} alt={siteName} class="footer-logo" height="50" />}
              <p>{siteDescription}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Copyright -->
      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <div class="social-links">
            {socialLinks.facebook && (
              <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <i class="fab fa-facebook-f"></i>
              </a>
            )}
            {socialLinks.line && (
              <a href={socialLinks.line} target="_blank" rel="noopener noreferrer" aria-label="Line">
                <i class="fab fa-line"></i>
              </a>
            )}
          </div>
          <p class="copyright">{copyrightText}</p>
        </div>
      </div>

      <!-- Back to top -->
      <a href="#" class="back-to-top" id="back-to-top" aria-label="Back to top">
        <i class="fas fa-chevron-up"></i>
      </a>
    </footer>

    <!-- Cookie Consent -->
    <CookieConsent />

    <style is:global>
      @import "../styles/global.css";

      /* ─── Header ──────────────────────────────────────────────────── */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border-light);
        transition: all var(--transition);
      }

      .site-header.has-banner {
        top: 68px;
      }

      .site-header.scrolled {
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: var(--header-height);
      }

      .logo {
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .logo-text {
        font-size: 24px;
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.5px;
      }

      .main-nav {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .nav-link {
        padding: 8px 16px;
        color: var(--color-text);
        font-size: 15px;
        font-weight: 500;
        border-radius: var(--radius);
        transition: all var(--transition);
        text-decoration: none;
      }

      .nav-link:hover {
        color: var(--color-primary);
        background: var(--color-primary-light);
      }

      .nav-link.active {
        color: var(--color-primary);
        background: var(--color-primary-light);
      }

      .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .header-phone {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-text);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
      }

      .header-phone:hover {
        color: var(--color-primary);
      }

      .header-phone i {
        color: var(--color-primary);
      }

      .mobile-menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 22px;
        color: var(--color-text);
        cursor: pointer;
        padding: 8px;
      }

      /* ─── Mobile Nav ──────────────────────────────────────────────── */
      .mobile-nav {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background: #fff;
        z-index: 2000;
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
        transition: right var(--transition);
        display: flex;
        flex-direction: column;
        padding: 24px;
      }

      .mobile-nav.open {
        right: 0;
      }

      .mobile-nav-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
      }

      .mobile-menu-close {
        background: none;
        border: none;
        font-size: 24px;
        color: var(--color-text);
        cursor: pointer;
      }

      .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .mobile-nav-link {
        padding: 12px 16px;
        color: var(--color-text);
        font-size: 16px;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        transition: all var(--transition);
      }

      .mobile-nav-link:hover,
      .mobile-nav-link.active {
        color: var(--color-primary);
        background: var(--color-primary-light);
      }

      .mobile-nav-phone {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        background: var(--color-primary-light);
        color: var(--color-primary);
        border-radius: var(--radius);
        font-weight: 500;
        text-decoration: none;
      }

      /* ─── Footer ──────────────────────────────────────────────────── */
      .site-footer {
        background: #1a1a2e;
        color: #ccc;
        padding-top: 60px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1.5fr;
        gap: 40px;
        padding-bottom: 40px;
      }

      .footer-col h4 {
        color: #fff;
        font-size: 16px;
        margin-bottom: 20px;
      }

      .footer-contact p {
        margin-bottom: 10px;
      }

      .footer-contact a {
        color: #ccc;
        text-decoration: none;
        transition: color var(--transition);
      }

      .footer-contact a:hover {
        color: var(--color-primary);
      }

      .footer-contact i {
        color: var(--color-primary);
        width: 20px;
        margin-right: 8px;
      }

      .footer-links li {
        margin-bottom: 8px;
      }

      .footer-links a {
        color: #ccc;
        text-decoration: none;
        font-size: 14px;
        transition: color var(--transition);
      }

      .footer-links a:hover {
        color: var(--color-primary);
      }

      .footer-about p {
        font-size: 14px;
        line-height: 1.7;
        color: #999;
      }

      .footer-logo {
        margin-bottom: 16px;
        filter: brightness(0) invert(1);
        opacity: 0.8;
      }

      .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding: 20px 0;
      }

      .footer-bottom-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .social-links {
        display: flex;
        gap: 12px;
      }

      .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        color: #ccc;
        font-size: 14px;
        transition: all var(--transition);
      }

      .social-links a:hover {
        background: var(--color-primary);
        color: #fff;
      }

      .copyright {
        font-size: 13px;
        color: #888;
      }

      /* ─── Back to Top ─────────────────────────────────────────────── */
      .back-to-top {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--color-primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 4px 12px rgba(1, 127, 228, 0.3);
        opacity: 0;
        pointer-events: none;
        transition: all var(--transition);
        z-index: 999;
      }

      .back-to-top.visible {
        opacity: 1;
        pointer-events: auto;
      }

      .back-to-top:hover {
        background: var(--color-primary-dark);
        transform: translateY(-2px);
        color: #fff;
      }

      /* ─── Responsive ──────────────────────────────────────────────── */
      @media (max-width: 768px) {
        .main-nav { display: none; }
        .header-phone span { display: none; }
        .mobile-menu-toggle { display: block; }

        body { padding-top: var(--header-height); }
        .site-header.has-banner { top: 0; }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: 32px;
        }

        .footer-bottom-inner {
          flex-direction: column;
          gap: 12px;
          text-align: center;
        }
      }
    </style>

    <script>
      // Header scroll effect
      const header = document.getElementById("site-header");
      const backToTop = document.getElementById("back-to-top");

      window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
          header?.classList.add("scrolled");
        } else {
          header?.classList.remove("scrolled");
        }

        if (window.scrollY > 400) {
          backToTop?.classList.add("visible");
        } else {
          backToTop?.classList.remove("visible");
        }
      });

      // Mobile menu
      const menuToggle = document.getElementById("mobile-menu-toggle");
      const menuClose = document.getElementById("mobile-menu-close");
      const mobileNav = document.getElementById("mobile-nav");

      menuToggle?.addEventListener("click", () => {
        mobileNav?.classList.add("open");
      });

      menuClose?.addEventListener("click", () => {
        mobileNav?.classList.remove("open");
      });

      // Close mobile menu when clicking a link
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav?.classList.remove("open");
        });
      });

      // Back to top
      backToTop?.addEventListener("click", (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
