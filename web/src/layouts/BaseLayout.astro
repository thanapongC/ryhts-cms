---
/**
 * BaseLayout — main layout component for all pages.
 *
 * Source: rules/seo-rule.md §Frontend Metadata Rules
 * Design: rules/design-rule.md §8 (Header/Navigation)
 */

import { safeGetContactFloating, safeGetCookieSetting, safeGetFooterSetting, safeGetGlobalSetting, getStrapiMedia } from "../lib/api";
import { detectLocale, type Locale } from "../lib/i18n";
import { siteConfig, generateHreflangs, type HreflangLink, type OgType } from "../lib/seo";
import ErrorBanner from "../components/ErrorBanner.astro";
import CookieConsent from "../components/CookieConsent.astro";
import SeoHead from "../components/SeoHead.astro";
import OrganizationSchema from "../components/seo/OrganizationSchema.astro";
import WebSiteSchema from "../components/seo/WebSiteSchema.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import FloatingContact from "../components/FloatingContact.astro";

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

interface ProductMeta {
  price?: string;
  currency?: string;
  availability?: string;
  brand?: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  ogType?: OgType;
  robots?: string;
  author?: string;
  keywords?: string[];
  themeColor?: string;
  locale?: string;
  twitterSite?: string;
  twitterCreator?: string;
  facebookAppId?: string;
  hreflangs?: HreflangLink[];
  article?: ArticleMeta;
  product?: ProductMeta;
  ogVideo?: string;
  ogAudio?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  canonical,
  ogType,
  robots,
  author,
  keywords,
  themeColor,
  locale: propLocale,
  twitterSite,
  twitterCreator,
  facebookAppId,
  hreflangs,
  article,
  product,
  ogVideo,
  ogAudio,
  jsonLd,
} = Astro.props;

// Detect locale from URL path: /th/about → "th", /en/about → "en"
const urlLocale = Astro.params.locale as string;
const cookieHeader = Astro.request.headers.get("cookie") || undefined;
const acceptLanguage = Astro.request.headers.get("accept-language") || undefined;
const detectedLocale = detectLocale(cookieHeader, acceptLanguage);
const locale = (propLocale || urlLocale || detectedLocale) as Locale;

const footerResult = await safeGetFooterSetting(locale);
const globalResult = await safeGetGlobalSetting(locale);
const contactFloatingResult = await safeGetContactFloating(locale);
const cookieSettingResult = await safeGetCookieSetting(locale);

const footerSetting = footerResult.data;
const globalSetting = globalResult.data;
const contactFloating = contactFloatingResult.data;
const cookieSetting = cookieSettingResult.data;
const isOffline = footerResult.isOffline || globalResult.isOffline || contactFloatingResult.isOffline || cookieSettingResult.isOffline;

const siteName = globalSetting?.siteName || siteConfig.siteName;
const siteDescription = globalSetting?.seoConfig?.defaultDescription || siteConfig.defaultDescription;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const metaDescription = description || siteDescription;
const logoUrl = getStrapiMedia(globalSetting?.siteLogo?.url);

// Default OG image priority: page prop > global SEO config > site logo > static fallback
const globalOgImage = getStrapiMedia(globalResult.data?.seoConfig?.defaultOgImage?.url);
const defaultOgImage = globalOgImage || globalSetting?.siteLogo?.url || "/og-default.svg";
const resolvedOgImage = ogImage || defaultOgImage;

// Generate hreflang tags using SEO module
const currentPath = Astro.url.pathname;
const defaultHreflangs = generateHreflangs(currentPath);
const resolvedHreflangs = hreflangs || defaultHreflangs;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={pageTitle}
      description={metaDescription}
      ogImage={resolvedOgImage}
      ogImageAlt={ogImageAlt}
      canonical={canonical}
      ogType={ogType}
      robots={robots}
      author={author}
      keywords={keywords}
      themeColor={themeColor}
      twitterSite={twitterSite}
      twitterCreator={twitterCreator}
      facebookAppId={facebookAppId}
      hreflangs={resolvedHreflangs}
      article={article}
      product={product}
      ogVideo={ogVideo}
      ogAudio={ogAudio}
      jsonLd={jsonLd}
    />
    <!-- Global JSON-LD: Organization and WebSite (rules/seo-rule.md §Structured Data Rules) -->
    <OrganizationSchema
      name={siteName}
      logo={logoUrl}
    />
    <WebSiteSchema
      name={siteName}
      description={siteDescription}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body>
    <!-- Offline Banner -->
    {isOffline && <ErrorBanner message="Unable to connect to the server. Some content may be outdated." />}

    <SiteHeader
      locale={locale}
      isOffline={isOffline}
      logoUrl={logoUrl}
      siteName={siteName}
    />

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <Footer
      locale={locale}
      footerSetting={footerSetting}
      globalSetting={globalSetting}
      logoUrl={logoUrl}
      siteName={siteName}
      siteDescription={siteDescription}
    />

    <FloatingContact contactFloating={contactFloating} />

    <!-- Cookie Consent -->
    <CookieConsent locale={locale} cookieSetting={cookieSetting} />

    <style is:global>
      @import "../styles/global.css";
    </style>
  </body>
</html>
