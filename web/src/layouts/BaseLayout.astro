---
import { safeGetFooterSetting, safeGetGlobalSetting, getStrapiMedia } from "../lib/api";
import { detectLocale, type Locale } from "../lib/i18n";
import ErrorBanner from "../components/ErrorBanner.astro";
import CookieConsent from "../components/CookieConsent.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import SeoHead from "../components/SeoHead.astro";
import Footer from "../components/Footer.astro";

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

interface ProductMeta {
  price?: string;
  currency?: string;
  availability?: string;
  brand?: string;
}

interface Hreflang {
  lang: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  ogType?: "website" | "article" | "product";
  robots?: string;
  author?: string;
  keywords?: string[];
  themeColor?: string;
  locale?: string;
  twitterSite?: string;
  twitterCreator?: string;
  facebookAppId?: string;
  hreflangs?: Hreflang[];
  article?: ArticleMeta;
  product?: ProductMeta;
  ogVideo?: string;
  ogAudio?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  canonical,
  ogType,
  robots,
  author,
  keywords,
  themeColor,
  locale: propLocale,
  twitterSite,
  twitterCreator,
  facebookAppId,
  hreflangs,
  article,
  product,
  ogVideo,
  ogAudio,
  jsonLd,
} = Astro.props;

// Detect locale from URL path: /th/about → "th", /en/about → "en"
const urlLocale = Astro.params.locale as string;
const cookieHeader = Astro.request.headers.get("cookie") || undefined;
const acceptLanguage = Astro.request.headers.get("accept-language") || undefined;
const detectedLocale = detectLocale(cookieHeader, acceptLanguage);
const locale = propLocale || urlLocale || detectedLocale;

const footerResult = await safeGetFooterSetting(locale);
const globalResult = await safeGetGlobalSetting(locale);

const footerSetting = footerResult.data;
const globalSetting = globalResult.data;
const isOffline = footerResult.isOffline || globalResult.isOffline;

const siteName = globalSetting?.siteName || "RYHTS";
const siteDescription = globalSetting?.seoConfig?.defaultDescription || "Premier Ribbons for Premier Printing";
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const metaDescription = description || siteDescription;
const logoUrl = getStrapiMedia(globalSetting?.siteLogo?.url);

// Default OG image priority: page prop > global SEO config > site logo > static fallback
const globalOgImage = getStrapiMedia(globalResult.data?.seoConfig?.defaultOgImage?.url);
const defaultOgImage = globalOgImage || globalSetting?.siteLogo?.url || "/og-default.svg";
const resolvedOgImage = ogImage || defaultOgImage;

const navItems = [
  { label: "Home", href: `/${locale}/` },
  { label: "About us", href: `/${locale}/about` },
  { label: "Products", href: `/${locale}/products` },
  { label: "Articles", href: `/${locale}/articles` },
  { label: "Contact us", href: `/${locale}/contact` },
];

// Generate hreflang tags for multilingual support
// Current site supports: th (Thai), en (English)
const currentPath = Astro.url.pathname;
const siteOrigin = Astro.url.origin;

// Helper to build language-specific URL
function getLanguageUrl(lang: string): string {
  // Replace current locale prefix with target locale
  const pathWithoutLocale = currentPath.replace(/^\/(th|en)/, "") || "/";
  return `${siteOrigin}/${lang}${pathWithoutLocale === "/" ? "/" : pathWithoutLocale}`;
}

// Default hreflangs if not provided by page
const defaultHreflangs: Hreflang[] = [
  { lang: "th", href: getLanguageUrl("th") },
  { lang: "en", href: getLanguageUrl("en") },
  { lang: "x-default", href: getLanguageUrl("th") }, // Default to Thai
];

const resolvedHreflangs = hreflangs || defaultHreflangs;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={pageTitle}
      description={metaDescription}
      ogImage={resolvedOgImage}
      ogImageAlt={ogImageAlt}
      canonical={canonical}
      ogType={ogType}
      robots={robots}
      author={author}
      keywords={keywords}
      themeColor={themeColor}
      twitterSite={twitterSite}
      twitterCreator={twitterCreator}
      facebookAppId={facebookAppId}
      hreflangs={resolvedHreflangs}
      article={article}
      product={product}
      ogVideo={ogVideo}
      ogAudio={ogAudio}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body>
    <!-- Offline Banner -->
    {isOffline && <ErrorBanner message="Unable to connect to the server. Some content may be outdated." />}

    <!-- Header -->
    <header class:list={["site-header", { "has-banner": isOffline }]} id="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          {logoUrl ? (
            <img src={logoUrl} alt={siteName} height="40" />
          ) : (
            <span class="logo-text">{siteName}</span>
          )}
        </a>

        <nav class="main-nav" id="main-nav">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["nav-link", { active: Astro.url.pathname === item.href || (item.href !== "/" && Astro.url.pathname.startsWith(item.href)) }]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-right">
          <LanguageSwitcher currentLocale={locale} />
          <SearchOverlay />
          
          <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle menu">
            <i class="fas fa-bars"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div class="mobile-nav" id="mobile-nav">
        <div class="mobile-nav-header">
          <span class="logo-text">{siteName}</span>
          <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <nav class="mobile-nav-links">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["mobile-nav-link", { active: Astro.url.pathname === item.href }]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <Footer
      locale={locale}
      footerSetting={footerSetting}
      logoUrl={logoUrl}
      siteName={siteName}
      siteDescription={siteDescription}
    />

    <!-- Cookie Consent -->
    <CookieConsent />

    <style is:global>
      @import "../styles/global.css";

      /* ─── Header ──────────────────────────────────────────────────── */
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border-light);
        transition: all var(--transition);
      }

      .site-header.has-banner {
        top: 68px;
      }

      .site-header.scrolled {
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: var(--header-height);
      }

      .logo {
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .logo-text {
        font-size: 24px;
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: -0.5px;
      }

      .main-nav {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .nav-link {
        padding: 8px 16px;
        color: var(--color-text);
        font-size: 15px;
        font-weight: 500;
        border-radius: var(--radius);
        transition: all var(--transition);
        text-decoration: none;
      }

      .nav-link:hover {
        color: var(--color-primary);
        background: var(--color-primary-light);
      }

      .nav-link.active {
        color: var(--color-primary);
        background: var(--color-primary-light);
      }

      .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .header-phone {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-text);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
      }

      .header-phone:hover {
        color: var(--color-primary);
      }

      .header-phone i {
        color: var(--color-primary);
      }

      .mobile-menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 22px;
        color: var(--color-text);
        cursor: pointer;
        padding: 8px;
      }

      /* ─── Mobile Nav ──────────────────────────────────────────────── */
      .mobile-nav {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background: #fff;
        z-index: 2000;
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
        transition: right var(--transition);
        display: flex;
        flex-direction: column;
        padding: 24px;
      }

      .mobile-nav.open {
        right: 0;
      }

      .mobile-nav-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
      }

      .mobile-menu-close {
        background: none;
        border: none;
        font-size: 24px;
        color: var(--color-text);
        cursor: pointer;
      }

      .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .mobile-nav-link {
        padding: 12px 16px;
        color: var(--color-text);
        font-size: 16px;
        font-weight: 500;
        border-radius: var(--radius);
        text-decoration: none;
        transition: all var(--transition);
      }

      .mobile-nav-link:hover,
      .mobile-nav-link.active {
        color: var(--color-primary);
        background: var(--color-primary-light);
      }

      .mobile-nav-phone {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        background: var(--color-primary-light);
        color: var(--color-primary);
        border-radius: var(--radius);
        font-weight: 500;
        text-decoration: none;
      }

      /* ─── Responsive ──────────────────────────────────────────────── */
      @media (max-width: 768px) {
        .main-nav { display: none; }
        .header-phone span { display: none; }
        .mobile-menu-toggle { display: block; }

        body { padding-top: var(--header-height); }
        .site-header.has-banner { top: 0; }
      }
    </style>

    <script>
      // Header scroll effect
      const header = document.getElementById("site-header");

      window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
          header?.classList.add("scrolled");
        } else {
          header?.classList.remove("scrolled");
        }
      });

      // Mobile menu
      const menuToggle = document.getElementById("mobile-menu-toggle");
      const menuClose = document.getElementById("mobile-menu-close");
      const mobileNav = document.getElementById("mobile-nav");

      menuToggle?.addEventListener("click", () => {
        mobileNav?.classList.add("open");
      });

      menuClose?.addEventListener("click", () => {
        mobileNav?.classList.remove("open");
      });

      // Close mobile menu when clicking a link
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileNav?.classList.remove("open");
        });
      });
    </script>
  </body>
</html>
