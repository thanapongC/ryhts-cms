---
/**
 * OrganizationSchema — JSON-LD structured data for Organization.
 *
 * Should be rendered on every page for brand recognition.
 * Source: rules/seo-rule.md §Structured Data Rules
 */

import { siteConfig } from "../../lib/seo/config";

interface Props {
  /** Organization name (defaults to brand name) */
  name?: string;

  /** Organization URL */
  url?: string;

  /** Logo URL */
  logo?: string;

  /** Contact email */
  email?: string;

  /** Contact phone */
  phone?: string;

  /** Social media URLs */
  socialLinks?: {
    facebook?: string;
    line?: string;
    linkedin?: string;
    youtube?: string;
    twitter?: string;
  };
}

const {
  name = siteConfig.brandName,
  url = siteConfig.siteUrl,
  logo,
  email,
  phone,
  socialLinks = {},
} = Astro.props;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name,
  url,
  ...(logo && { logo }),
  ...(email && {
    email,
  }),
  ...(phone && {
    telephone: phone,
  }),
  ...(socialLinks.facebook && { sameAs: [socialLinks.facebook] }),
  ...(socialLinks.line && { sameAs: [...(socialLinks.sameAs || []), socialLinks.line] }),
  ...(socialLinks.linkedin && { sameAs: [...(socialLinks.sameAs || []), socialLinks.linkedin] }),
  ...(socialLinks.youtube && { sameAs: [...(socialLinks.sameAs || []), socialLinks.youtube] }),
  ...(socialLinks.twitter && { sameAs: [...(socialLinks.sameAs || []), socialLinks.twitter] }),
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    ...(email && { email }),
    ...(phone && { telephone: phone }),
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(organization)} />
