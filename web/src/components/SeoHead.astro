---
/**
 * SeoHead — comprehensive SEO meta tags component.
 *
 * Renders: title, description, canonical, OG tags, Twitter cards,
 * robots directives, author, keywords, hreflang, article metadata,
 * and JSON-LD structured data.
 */

import { getStrapiMedia } from "../lib/api";

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

interface ProductMeta {
  price?: string;
  currency?: string;
  availability?: string;
  brand?: string;
}

interface Hreflang {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article" | "product";
  robots?: string;
  author?: string;
  keywords?: string[];
  themeColor?: string;
  // Social handles
  twitterSite?: string;
  twitterCreator?: string;
  facebookAppId?: string;
  // Hreflang for multilingual
  hreflangs?: Hreflang[];
  // Article-specific metadata
  article?: ArticleMeta;
  // Product-specific metadata
  product?: ProductMeta;
  // Additional OG tags
  ogVideo?: string;
  ogAudio?: string;
  // JSON-LD structured data
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "",
  canonical,
  ogImage,
  ogImageAlt,
  ogType = "website",
  robots = "index, follow",
  author,
  keywords = [],
  themeColor = "#017fe4",
  twitterSite,
  twitterCreator,
  facebookAppId,
  hreflangs = [],
  article,
  product,
  ogVideo,
  ogAudio,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.url.origin;
const resolvedOgImage = ogImage ? getStrapiMedia(ogImage) : "";

// Clean canonical URL: remove query params and ensure trailing slash consistency
function cleanCanonicalUrl(url: string): string {
  try {
    const parsed = new URL(url);
    // Remove query parameters and hash
    let pathname = parsed.pathname;
    // Ensure trailing slash for consistency (except root)
    if (pathname !== "/" && !pathname.endsWith("/")) {
      pathname += "/";
    }
    return `${parsed.origin}${pathname}`;
  } catch {
    return url;
  }
}

const canonicalUrl = canonical ? cleanCanonicalUrl(canonical) : cleanCanonicalUrl(Astro.url.href);
const keywordsString = keywords.length > 0 ? keywords.join(", ") : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />

{author && <meta name="author" content={author} />}
{keywordsString && <meta name="keywords" content={keywordsString} />}
{themeColor && <meta name="theme-color" content={themeColor} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Ryhts Ribbon" />
<meta property="og:locale" content="th_TH" />
<meta property="og:locale:alternate" content="en_US" />
{resolvedOgImage && (
  <>
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || title} />
    <meta property="og:image:type" content="image/png" />
  </>
)}
{ogVideo && <meta property="og:video" content={ogVideo} />}
{ogAudio && <meta property="og:audio" content={ogAudio} />}
{facebookAppId && <meta property="fb:app_id" content={facebookAppId} />}

<!-- Twitter -->
<meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedOgImage && (
  <>
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt || title} />
  </>
)}
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}

<!-- LinkedIn -->
<meta property="linkedin:owner" content={facebookAppId || ""} />

<!-- Pinterest -->
<meta name="pinterest-rich-pin" content="true" />

<!-- WhatsApp / LINE / Social Apps -->
<meta property="og:see_also" content={canonicalUrl} />

<!-- Hreflang -->
{hreflangs.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}

<!-- Article Metadata -->
{ogType === "article" && article && (
  <>
    {article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article.author && <meta property="article:author" content={article.author} />}
    {article.section && <meta property="article:section" content={article.section} />}
    {article.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Product Metadata -->
{ogType === "product" && product && (
  <>
    {product.price && <meta property="product:price:amount" content={product.price} />}
    {product.currency && <meta property="product:price:currency" content={product.currency} />}
    {product.availability && <meta property="product:availability" content={product.availability} />}
    {product.brand && <meta property="product:brand" content={product.brand} />}
  </>
)}

<!-- JSON-LD -->
{jsonLd && (
  <>
    {Array.isArray(jsonLd) ? (
      jsonLd.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </>
)}
