---
/**
 * HeroSection — Homepage hero section with customer badge.
 *
 * Props:
 *   customerCount?: number — Number of customers to display
 */
interface Props {
  customerCount?: number;
}

const { customerCount = 100 } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <h1>Premier Ribbon for Premier Printing</h1>
      <p>
        ไรต์ส (ryhts) เราคือผู้จำหน่ายริบบอนหรือผ้าหมึกพิมพ์สำหรับใช้กับเครื่องพิมพ์บาร์โค้ดทุกขนาด
        มีให้ท่านเลือกใช้หลากหลายแบบ เรามุ่งมั่นที่จะพัฒนาสินค้านำเข้าที่ได้มาตรฐาน
      </p>
      <div class="hero-actions">
        <a href="/products" class="btn btn-primary btn-lg">ดูสินค้าทั้งหมด</a>
        <a href="/about" class="btn btn-outline btn-lg">รู้จัก Ryhts</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-shape"></div>
      <div class="hero-badge">
        <span class="hero-badge-number">{customerCount}+</span>
        <span class="hero-badge-text">ลูกค้าที่ไว้วางใจ</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 140px 0 80px;
    background: var(--color-background);
    min-height: 520px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content h1 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--color-text-primary);
  }

  .hero-content p {
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-shape {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    opacity: 0.08;
    position: absolute;
  }

  .hero-badge {
    position: relative;
    z-index: 1;
    text-align: center;
    background: #FFFFFF;
    padding: 40px;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border-light);
  }

  .hero-badge-number {
    display: block;
    font-size: 56px;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .hero-badge-text {
    display: block;
    font-size: 16px;
    color: var(--color-text-muted);
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 120px 0 60px;
      min-height: auto;
    }

    .hero-content h1 {
      font-size: 32px;
    }
  }
</style>
