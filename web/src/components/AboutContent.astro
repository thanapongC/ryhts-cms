---
/**
 * AboutContent — Renders the About page with CMS data + fallback.
 *
 * CMS data: page copy, stats, team members, partners, timeline milestones, contact info, SEO.
 * Rules: integate-rule.md §18 About Us
 *
 * Props:
 *   lang: Locale
 *   page: AboutPage | null (CMS data)
 *   companyInfo: CompanyInfo | null
 */
import { getStrapiMedia, getStrapiAbsoluteImageUrl, filterAndSort, type AboutPage } from "../lib/api";

interface Props {
  lang: "th" | "en";
  page: AboutPage | null;
}

const { lang, page } = Astro.props;

const pageTitle = page?.title || (lang === "en" ? "About Ryhts" : "เกี่ยวกับ Ryhts");
const featuredImage = page?.featuredImage ? getStrapiAbsoluteImageUrl(page.featuredImage) : "";
const stats = filterAndSort(page?.stats);
const teamMembers = filterAndSort(page?.teamMembers);
const partners = filterAndSort(page?.partners);
const milestones = filterAndSort(page?.timelineMilestones);

const fallbackContent = lang === "en"
  ? "Ryhts is a premier distributor of thermal transfer ribbons for barcode printers."
  : "ไรต์ส (Ryhts) เราคือผู้จำหน่ายริบบอนสำหรับเครื่องพิมพ์บาร์โค้ดทุกขนาด นำเข้าสินค้าคุณภาพสูงจากแบรนด์ชั้นนำทั่วโลก";
---

<!-- Hero Image -->
{featuredImage && (
  <div class="about-hero-image">
    <img src={featuredImage} alt={page?.title || ""} />
  </div>
)}

<!-- Page Content or Fallback -->
{page?.content ? (
  <div class="rich-text about-content" set:html={page.content} />
) : (
  <div class="about-default">
    <div class="about-grid">
      <div class="about-text">
        <h2>{page?.title || (lang === "en" ? "About Ryhts" : "เกี่ยวกับ Ryhts")}</h2>
        {page?.subtitle && <p class="about-subtitle">{page.subtitle}</p>}
        <p>{fallbackContent}</p>
      </div>
      {stats.length > 0 && (
        <div class="about-stats">
          {stats.map((stat) => (
            <div class="stat-item">
              <span class="stat-number">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
)}

<!-- Team Members -->
{teamMembers.length > 0 && (
  <div class="team-section">
    <h2>{lang === "en" ? "Our Team" : "ทีมงานของเรา"}</h2>
    <div class="team-grid">
      {teamMembers.map((member) => (
        <div class="team-card">
          {member.avatar && (
            <img src={getStrapiMedia(member.avatar.url)} alt={member.name} />
          )}
          <h3>{member.name}</h3>
          {member.position && <p class="team-position">{member.position}</p>}
          {member.bio && <p class="team-bio">{member.bio}</p>}
        </div>
      ))}
    </div>
  </div>
)}

<!-- Partners -->
{partners.length > 0 && (
  <div class="partners-section">
    <h2>{lang === "en" ? "Our Partners" : "พันธมิตรของเรา"}</h2>
    <div class="partners-grid">
      {partners.map((partner) => (
        <a class="partner-card" href={partner.websiteUrl || "#"} target={partner.websiteUrl ? "_blank" : undefined} rel={partner.websiteUrl ? "noopener noreferrer" : undefined}>
          {partner.logo && (
            <img src={getStrapiMedia(partner.logo.url)} alt={partner.name} />
          )}
          <p>{partner.name}</p>
        </a>
      ))}
    </div>
  </div>
)}

<!-- Timeline / History -->
{milestones.length > 0 && (
  <div class="timeline-section">
    <h2>{lang === "en" ? "Our History" : "ประวัติบริษัท"}</h2>
    <div class="timeline">
      {milestones.map((m) => (
        <div class="timeline-item">
          <div class="timeline-marker" />
          <div class="timeline-content">
            {m.milestoneDate && <span class="timeline-date">{m.milestoneDate}</span>}
            <h3>{m.title}</h3>
            {m.description && <p>{m.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .about-hero-image {
    margin-bottom: 40px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .about-hero-image img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
  }

  .about-content {
    max-width: 800px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .about-text h2 {
    font-size: 28px;
    margin-bottom: 12px;
    color: var(--color-text-primary);
  }

  .about-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .about-text p {
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .stat-item {
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    padding: 24px;
    border-radius: var(--radius-lg);
    text-align: center;
    margin-bottom: 16px;
  }

  .stat-number {
    display: block;
    font-size: 36px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    display: block;
    font-size: 14px;
    color: var(--color-text-muted);
    margin-top: 8px;
  }

  .team-section,
  .partners-section,
  .timeline-section {
    margin-top: 60px;
  }

  .team-section h2,
  .partners-section h2,
  .timeline-section h2 {
    font-size: 24px;
    margin-bottom: 24px;
    color: var(--color-text-primary);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .team-card {
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    padding: 24px;
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .team-card img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .team-card h3 {
    font-size: 18px;
    margin-bottom: 4px;
    color: var(--color-text-primary);
  }

  .team-position {
    font-size: 14px;
    color: var(--color-primary);
    margin-bottom: 8px;
  }

  .team-bio {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .partner-card {
    text-align: center;
    padding: 16px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    transition: all var(--transition);
    text-decoration: none;
    color: inherit;
  }

  .partner-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    border-color: var(--color-border-blue);
  }

  .partner-card img {
    max-height: 60px;
    object-fit: contain;
    margin-bottom: 8px;
  }

  .partner-card p {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .timeline {
    border-left: 3px solid var(--color-primary);
    padding-left: 24px;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 32px;
  }

  .timeline-marker {
    position: absolute;
    left: -30px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 0 3px var(--color-background-blue);
  }

  .timeline-date {
    font-size: 14px;
    color: var(--color-primary);
    font-weight: 600;
  }

  .timeline-content h3 {
    font-size: 18px;
    margin: 4px 0 8px;
    color: var(--color-text-primary);
  }

  .timeline-content p {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: 1fr; }
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
