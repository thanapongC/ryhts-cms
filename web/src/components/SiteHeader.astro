---
import { getLocale, type Locale } from "../lib/i18n";
import { safeGetNavigation } from "../lib/api";
import type { NavChildItem, NavItem } from "../lib/api";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SearchOverlay from "./SearchOverlay.astro";

interface Props {
  locale: Locale;
  isOffline?: boolean;
  logoUrl?: string;
  siteName: string;
}

const { locale, isOffline = false, logoUrl, siteName } = Astro.props;
const t = getLocale(locale);

const fallbackNavItems: NavItem[] = [
  { label: t.nav.home, url: "/" },
  { label: t.nav.about, url: "/about/" },
  {
    label: t.nav.products,
    url: "/products/",
    children: [
      { label: t.products.istockExpress, url: "/products/istock-express/" },
      { label: t.products.istockExpressPro, url: "/products/istock-express-pro/" },
      { label: t.products.istockWMS, url: "/products/istock-wms/" },
    ],
  },
  { label: t.nav.support, url: "/support/" },
  { label: t.nav.news, url: "/articles/" },
  { label: t.nav.contact, url: "/contact/" },
];

const navigationResult = await safeGetNavigation(locale);
const cmsHeaderItems = navigationResult.data?.headerItems || [];
const sourceNavItems = navigationResult.ok && cmsHeaderItems.length > 0 ? cmsHeaderItems : fallbackNavItems;

function normalizeHeaderUrl(url?: string) {
  if (!url) return "#";
  if (/^(https?:|mailto:|tel:|#)/.test(url)) return url;

  const path = url.replace(/^\/(th|en)\//, "/");
  if (path === "/" || path === "") return t.home;
  return path.startsWith("/") ? `${t.home}${path.replace(/^\//, "")}` : path;
}

function getChildUrl(child: NavChildItem) {
  if (child.productPage?.slug) return `${t.home}products/${child.productPage.slug}/`;
  return normalizeHeaderUrl(child.url);
}

const navItems = sourceNavItems.map((item) => {
  const children = (item.children || []).map((child) => ({
    label: child.label,
    href: getChildUrl(child),
    target: child.target || "_self",
  }));

  return {
    label: item.label,
    href: normalizeHeaderUrl(item.url),
    target: item.target || "_self",
    children,
  };
});

function isActiveHref(href: string) {
  const path = Astro.url.pathname;
  if (href === t.home) return path === href;
  if (/^(https?:|mailto:|tel:|#)/.test(href)) return false;
  return path === href || path.startsWith(href.replace(/\/$/, ""));
}
---

<header class:list={["site-header", { "has-banner": isOffline }]} id="site-header">
  <div class="container header-inner">
    <a href={t.home} class="logo" aria-label={siteName}>
      {logoUrl ? (
        <img src={logoUrl} alt={siteName} height="40" />
      ) : (
        <span class="logo-text">{siteName}</span>
      )}
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      {navItems.map((item) => (
        <div class:list={["nav-item", { "has-children": item.children.length > 0 }]}>
          <a
            href={item.href}
            target={item.target}
            rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
            class:list={["nav-link", { active: isActiveHref(item.href) }]}
            aria-haspopup={item.children.length > 0 ? "true" : undefined}
          >
            {item.label}
            {item.children.length > 0 && <i class="fas fa-chevron-down nav-caret" aria-hidden="true"></i>}
          </a>
          {item.children.length > 0 && (
            <div class="nav-dropdown">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  target={child.target}
                  rel={child.target === "_blank" ? "noopener noreferrer" : undefined}
                  class:list={["nav-dropdown-link", { active: isActiveHref(child.href) }]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="header-right">
      <LanguageSwitcher currentLocale={locale} />
      <SearchOverlay locale={locale} />

      <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-header">
      <span class="logo-text">{siteName}</span>
      <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <nav class="mobile-nav-links" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <>
          <a
            href={item.href}
            target={item.target}
            rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
            class:list={["mobile-nav-link", { active: isActiveHref(item.href) }]}
          >
            {item.label}
          </a>
          {item.children.map((child) => (
            <a
              href={child.href}
              target={child.target}
              rel={child.target === "_blank" ? "noopener noreferrer" : undefined}
              class:list={["mobile-nav-link", "mobile-nav-child", { active: isActiveHref(child.href) }]}
            >
              {child.label}
            </a>
          ))}
        </>
      ))}
    </nav>
  </div>
</header>

<style is:global>
  /* ─── Header (design-rule.md §8) ──────────────────────────────── */
  html {
    scroll-padding-top: var(--header-height);
  }

  body {
    padding-top: var(--header-height);
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-light);
    transition: all var(--transition);
  }

  .site-header.has-banner {
    top: 0;
  }

  .site-header.scrolled {
    box-shadow: var(--shadow);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .logo:hover {
    opacity: 0.9;
  }

  .logo-text {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    color: var(--color-text-primary);
    font-size: 15px;
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
    text-decoration: none;
    position: relative;
  }

  .nav-caret {
    font-size: 11px;
    transition: transform var(--transition);
  }

  .nav-item:hover .nav-caret,
  .nav-item:focus-within .nav-caret {
    transform: rotate(180deg);
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: var(--color-background-blue);
  }

  .nav-link.active {
    color: var(--color-primary);
    background: var(--color-background-blue);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: all var(--transition);
    transform: translateX(-50%);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 60%;
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 230px;
    padding: 8px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-elevated);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }

  .nav-item:hover .nav-dropdown,
  .nav-item:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-link {
    display: block;
    padding: 10px 12px;
    color: var(--color-text-primary);
    font-size: 14px;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition);
    white-space: nowrap;
  }

  .nav-dropdown-link:hover,
  .nav-dropdown-link.active {
    color: var(--color-primary);
    background: var(--color-background-blue);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-phone {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-primary);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition);
  }

  .header-phone:hover {
    color: var(--color-primary);
  }

  .header-phone i {
    color: var(--color-primary);
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 22px;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: 8px;
    transition: color var(--transition);
  }

  .mobile-menu-toggle:hover {
    color: var(--color-primary);
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 300px;
    height: 100vh;
    background: var(--color-background);
    z-index: var(--z-mobile-nav);
    box-shadow: var(--shadow-elevated);
    transition: right var(--transition);
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .mobile-nav[aria-hidden="false"] {
    right: 0;
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .mobile-menu-close {
    background: none;
    border: none;
    font-size: 24px;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: color var(--transition);
  }

  .mobile-menu-close:hover {
    color: var(--color-primary);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-link {
    padding: 12px 16px;
    color: var(--color-text-primary);
    font-size: 16px;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-primary);
    background: var(--color-background-blue);
  }

  .mobile-nav-child {
    margin-left: 12px;
    padding-left: 28px;
    color: var(--color-text-secondary);
    font-size: 15px;
  }

  .mobile-nav-phone {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: var(--color-background-blue);
    color: var(--color-primary);
    border-radius: var(--radius-sm);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
  }

  .mobile-nav-phone:hover {
    background: var(--color-primary);
    color: var(--color-text-on-blue);
  }

  @media (max-width: 768px) {
    .main-nav { display: none; }
    .header-phone span { display: none; }
    .mobile-menu-toggle { display: block; }
  }
</style>

<script>
  const header = document.getElementById("site-header");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header?.classList.add("scrolled");
    } else {
      header?.classList.remove("scrolled");
    }
  });

  const menuToggle = document.getElementById("mobile-menu-toggle");
  const menuClose = document.getElementById("mobile-menu-close");
  const mobileNav = document.getElementById("mobile-nav");

  menuToggle?.addEventListener("click", () => {
    const isOpen = mobileNav?.getAttribute("aria-hidden") === "false";
    mobileNav?.setAttribute("aria-hidden", String(isOpen));
    menuToggle?.setAttribute("aria-expanded", String(!isOpen));
  });

  menuClose?.addEventListener("click", () => {
    mobileNav?.setAttribute("aria-hidden", "true");
    menuToggle?.setAttribute("aria-expanded", "false");
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav?.setAttribute("aria-hidden", "true");
      menuToggle?.setAttribute("aria-expanded", "false");
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileNav?.getAttribute("aria-hidden") === "false") {
      mobileNav?.setAttribute("aria-hidden", "true");
      menuToggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>
