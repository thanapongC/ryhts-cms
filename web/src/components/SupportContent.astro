---
/**
 * SupportContent — Renders the Support page with CMS data + fallback.
 *
 * CMS data: hero section, status card, FAQ section, FAQ relations,
 *           help center section, help resource relations, contact section,
 *           global contact settings relation, SEO.
 * Rules: integate-rule.md §18 Support
 *
 * Props:
 *   lang: Locale
 *   page: SupportPage | null
 */
import { filterAndSort, normalizeInternalUrl, type SupportPage } from "../lib/api";

interface Props {
  lang: "th" | "en";
  page: SupportPage | null;
}

const { lang, page } = Astro.props;

// Section data with fallbacks (integate-rule.md §7)
const hero = page?.heroSection;
const statusCard = page?.statusCard;
const faqSection = page?.faqSection;
const helpCenter = page?.helpCenterSection;
const contactSection = page?.contactSection;
const contactSettings = page?.contactSettings;

const faqs = filterAndSort(page?.faqs);
const helpResources = filterAndSort(page?.helpResources);

const fallbackHero = {
  badge: lang === "en" ? "Support" : "ศูนย์ช่วยเหลือ",
  title: lang === "en" ? "How Can We Help?" : "เราช่วยคุณได้อย่างไร?",
  subtitle: lang === "en"
    ? "Find answers to common questions or reach out to our support team"
    : "ค้นหาคำตอบสำหรับคำถามที่พบบ่อย หรือติดต่อทีมสนับสนุนของเรา",
  faqCtaLabel: lang === "en" ? "Browse FAQ" : "ดูคำถามที่พบบ่อย",
  manualCtaLabel: lang === "en" ? "Read Manuals" : "อ่านคู่มือ",
  contactCtaLabel: lang === "en" ? "Contact Support" : "ติดต่อฝ่ายสนับสนุน",
};

const fallbackFaqSection = {
  badge: lang === "en" ? "FAQ" : "คำถามที่พบบ่อย",
  title: lang === "en" ? "Frequently Asked Questions" : "คำถามที่พบบ่อย",
  subtitle: lang === "en"
    ? "Quick answers to the most common questions"
    : "คำตอบรวดเร็วสำหรับคำถามที่พบบ่อยที่สุด",
  emptyPrompt: lang === "en" ? "No FAQs available yet." : "ยังไม่มีคำถามที่พบบ่อย",
  contactCtaLabel: lang === "en" ? "Ask a Question" : "ถามคำถาม",
};

const fallbackHelpCenter = {
  badge: lang === "en" ? "Resources" : "แหล่งข้อมูล",
  title: lang === "en" ? "Help Center" : "ศูนย์ช่วยเหลือ",
  subtitle: lang === "en"
    ? "Manuals, guides, and troubleshooting"
    : "คู่มือ แนวทางการแก้ปัญหา",
};

const fallbackContactSection = {
  badge: lang === "en" ? "Contact" : "ติดต่อ",
  title: lang === "en" ? "Get in Touch" : "ติดต่อเรา",
  addressLabel: lang === "en" ? "Address" : "ที่อยู่",
  businessHoursLabel: lang === "en" ? "Business Hours" : "เวลาทำการ",
  phoneLabel: lang === "en" ? "Phone" : "โทรศัพท์",
  emailLabel: lang === "en" ? "Email" : "อีเมล",
};

const displayHero = hero || fallbackHero;
const displayFaqSection = faqSection || fallbackFaqSection;
const displayHelpCenter = helpCenter || fallbackHelpCenter;
const displayContactSection = contactSection || fallbackContactSection;

// Quick help links (static fallback)
const quickHelpLinks = [
  { icon: "box", label: lang === "en" ? "Product Catalog" : "แคตตาล็อกสินค้า", url: `/${lang}/products` },
  { icon: "file-alt", label: lang === "en" ? "Privacy Policy" : "นโยบายความเป็นส่วนตัว", url: `/${lang}/privacy-policy` },
  { icon: "shield-alt", label: "PDPA", url: `/${lang}/pdpa` },
  { icon: "file-contract", label: lang === "en" ? "Terms of Service" : "ข้อกำหนดการใช้งาน", url: `/${lang}/terms-of-service` },
];

const homePrefix = `/${lang}/`;
const contactInfo = contactSettings?.contactInfo;
const displayPhone = contactInfo?.phone || "094-624-6649";
const displayEmail = contactInfo?.email || "sales@ryhts.com";
---

<!-- Hero -->
<section class="sup-hero">
  <div class="container">
    <div class="sup-hero-content">
      <div class="sup-hero-text">
        {displayHero.badge && <span class="badge badge-primary">{displayHero.badge}</span>}
        <h1>{displayHero.title}</h1>
        {displayHero.subtitle && <p>{displayHero.subtitle}</p>}
        <div class="sup-hero-ctas">
          <a href="#faq-section" class="btn btn-primary">
            <i class="fas fa-question-circle"></i>
            {displayHero.faqCtaLabel || fallbackHero.faqCtaLabel}
          </a>
          <a href="#contact-section" class="btn btn-outline">
            <i class="fas fa-headset"></i>
            {displayHero.contactCtaLabel || fallbackHero.contactCtaLabel}
          </a>
        </div>
      </div>

      {/* Status Card */}
      {statusCard && (
        <div class="sup-status-card">
          {statusCard.kicker && <span class="sup-status-kicker">{statusCard.kicker}</span>}
          {statusCard.title && <h3>{statusCard.title}</h3>}
          {statusCard.hours && <p class="sup-status-hours"><i class="fas fa-clock"></i> {statusCard.hours}</p>}
          {statusCard.statusLabel && (
            <div class="sup-status-badge">
              <span class="sup-status-dot"></span>
              {statusCard.statusLabel}
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<!-- Quick Help Links -->
<section class="section section-alt">
  <div class="container">
    <div class="sup-quick-links">
      {quickHelpLinks.map((link) => (
        <a href={link.url} class="sup-quick-link">
          <div class="sup-quick-icon"><i class={`fas fa-${link.icon}`}></i></div>
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="section" id="faq-section">
  <div class="container">
    <div class="sup-section-header">
      {displayFaqSection.badge && <span class="badge badge-primary">{displayFaqSection.badge}</span>}
      <h2>{displayFaqSection.title}</h2>
      {displayFaqSection.subtitle && <p>{displayFaqSection.subtitle}</p>}
    </div>

    {faqs.length > 0 ? (
      <div class="sup-faq-list">
        {faqs.map((faq) => (
          <details class="sup-faq-item">
            <summary class="sup-faq-question">
              <span>
                {faq.category && <small>{faq.category}</small>}
                {faq.question}
              </span>
              <i class="fas fa-chevron-down"></i>
            </summary>
            <div class="sup-faq-answer">
              <div class="rich-text" set:html={faq.answer} />
            </div>
          </details>
        ))}
      </div>
    ) : (
      <div class="sup-empty">
        <i class="fas fa-search"></i>
        <p>{displayFaqSection.emptyPrompt}</p>
        <a href="#contact-section" class="btn btn-outline btn-sm">
          {displayFaqSection.contactCtaLabel}
        </a>
      </div>
    )}
  </div>
</section>

<!-- Help Center -->
{helpResources.length > 0 && (
  <section class="section section-alt">
    <div class="container">
      <div class="sup-section-header">
        {displayHelpCenter.badge && <span class="badge badge-primary">{displayHelpCenter.badge}</span>}
        <h2>{displayHelpCenter.title}</h2>
        {displayHelpCenter.subtitle && <p>{displayHelpCenter.subtitle}</p>}
      </div>

      <div class="sup-help-grid">
        {helpResources.map((resource) => (
          <a class="sup-help-card" href={normalizeInternalUrl(resource.url, homePrefix)}>
            <h3>{resource.title}</h3>
            {resource.description && <p>{resource.description}</p>}
            <span>
              {resource.linkText || (lang === "en" ? "Open resource" : "ดูข้อมูล")}
              <i class="fas fa-arrow-right"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Contact Section -->
<section class="section" id="contact-section">
  <div class="container">
    <div class="sup-section-header">
      {displayContactSection.badge && <span class="badge badge-primary">{displayContactSection.badge}</span>}
      <h2>{displayContactSection.title}</h2>
    </div>

    <div class="sup-contact-grid">
      {contactInfo ? (
        <>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div>
              <strong>{displayContactSection.addressLabel}</strong>
              <span>{contactInfo.address || contactInfo.companyName || (lang === "en" ? "Ryhts Ribbon" : "ไรต์ส ริบบอน")}</span>
            </div>
          </div>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-phone"></i></div>
            <div>
              <strong>{displayContactSection.phoneLabel}</strong>
              <span><a href={`tel:${displayPhone.replace(/[^+\d]/g, "")}`}>{displayPhone}</a></span>
            </div>
          </div>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <strong>{displayContactSection.emailLabel}</strong>
              <span><a href={`mailto:${displayEmail}`}>{displayEmail}</a></span>
            </div>
          </div>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-clock"></i></div>
            <div>
              <strong>{displayContactSection.businessHoursLabel}</strong>
              <span>{contactInfo.businessHours || (lang === "en" ? "Mon - Fri, 8:30 AM - 5:30 PM" : "จันทร์ - ศุกร์, 08:30 - 17:30 น.")}</span>
            </div>
          </div>
        </>
      ) : (
        <>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div>
              <strong>{displayContactSection.addressLabel}</strong>
              <span>{lang === "en" ? "Ryhts Ribbon Co., Ltd." : "บริษัท ไรต์ส ริบบอน จำกัด"}</span>
            </div>
          </div>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-phone"></i></div>
            <div>
              <strong>{displayContactSection.phoneLabel}</strong>
              <span><a href="tel:0946246649">094-624-6649</a></span>
            </div>
          </div>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <strong>{displayContactSection.emailLabel}</strong>
              <span><a href="mailto:sales@ryhts.com">sales@ryhts.com</a></span>
            </div>
          </div>
          <div class="sup-contact-item">
            <div class="sup-contact-icon"><i class="fas fa-clock"></i></div>
            <div>
              <strong>{displayContactSection.businessHoursLabel}</strong>
              <span>{lang === "en" ? "Mon - Fri, 8:30 AM - 5:30 PM" : "จันทร์ - ศุกร์, 08:30 - 17:30 น."}</span>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</section>

<style>
  /* Hero */
  .sup-hero {
    background: var(--color-background);
    padding: 140px 0 80px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .sup-hero-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .sup-hero-text .badge {
    margin-bottom: 16px;
  }

  .sup-hero-text h1 {
    font-size: 40px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--color-text-primary);
  }

  .sup-hero-text p {
    font-size: 18px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .sup-hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Status Card */
  .sup-status-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .sup-status-kicker {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
  }

  .sup-status-card h3 {
    font-size: 22px;
    margin: 8px 0;
    color: var(--color-text-primary);
  }

  .sup-status-hours {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .sup-status-hours i {
    color: var(--color-primary);
    margin-right: 4px;
  }

  .sup-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #DCFCE7;
    color: #166534;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
  }

  .sup-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
  }

  /* Quick Links */
  .sup-quick-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .sup-quick-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--color-text-primary);
    transition: all var(--transition);
  }

  .sup-quick-link:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    color: var(--color-primary);
    border-color: var(--color-border-blue);
  }

  .sup-quick-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-background-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sup-quick-icon i {
    color: var(--color-primary);
    font-size: 16px;
  }

  .sup-quick-link span {
    font-size: 14px;
    font-weight: 500;
  }

  /* Section Headers */
  .sup-section-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .sup-section-header .badge {
    margin-bottom: 12px;
  }

  .sup-section-header h2 {
    font-size: 28px;
    margin-bottom: 8px;
    color: var(--color-text-primary);
  }

  .sup-section-header p {
    font-size: 16px;
    color: var(--color-text-secondary);
  }

  /* FAQ */
  .sup-faq-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .sup-faq-item {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    margin-bottom: 12px;
    overflow: hidden;
    transition: box-shadow var(--transition);
  }

  .sup-faq-item[open] {
    box-shadow: var(--shadow);
  }

  .sup-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    cursor: pointer;
    font-weight: 500;
    font-size: 16px;
    list-style: none;
  }

  .sup-faq-question span {
    display: grid;
    gap: 4px;
  }

  .sup-faq-question small {
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 600;
  }

  .sup-faq-question::-webkit-details-marker {
    display: none;
  }

  .sup-faq-question i {
    color: var(--color-text-muted);
    transition: transform var(--transition);
  }

  .sup-faq-item[open] .sup-faq-question i {
    transform: rotate(180deg);
  }

  .sup-faq-answer {
    padding: 0 24px 20px;
  }

  .sup-faq-qa {
    margin-bottom: 16px;
  }

  .sup-faq-qa:last-child {
    margin-bottom: 0;
  }

  .sup-faq-qa strong {
    display: block;
    font-size: 15px;
    margin-bottom: 6px;
  }

  .sup-empty {
    text-align: center;
    padding: 48px 20px;
  }

  .sup-empty i {
    font-size: 48px;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .sup-empty p {
    font-size: 16px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  /* Help Center */
  .sup-help-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .sup-help-card {
    display: block;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: all var(--transition);
  }

  .sup-help-card:hover {
    border-color: var(--color-border-blue);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .sup-help-card h3 {
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--color-text-primary);
  }

  .sup-help-card > p {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .sup-help-card span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Contact Section */
  .sup-contact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }

  .sup-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
  }

  .sup-contact-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-background-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sup-contact-icon i {
    color: var(--color-primary);
    font-size: 18px;
  }

  .sup-contact-item strong {
    display: block;
    font-size: 14px;
    margin-bottom: 4px;
  }

  .sup-contact-item span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .sup-contact-item a {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .sup-hero { padding: 120px 0 48px; }
    .sup-hero-content { grid-template-columns: 1fr; }
    .sup-hero-text h1 { font-size: 28px; }
    .sup-quick-links { grid-template-columns: repeat(2, 1fr); }
    .sup-help-grid { grid-template-columns: 1fr; }
    .sup-contact-grid { grid-template-columns: 1fr; }
  }
</style>
