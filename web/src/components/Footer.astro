---
import { getLocale, type Locale } from "../lib/i18n";
import { getGlobalSetting, getFooterSetting, getStrapiAbsoluteImageUrl } from "../lib/api";
import { siteConfig as seoConfig } from "../lib/seo/config";

interface Props {
  lang?: Locale;
  locale?: Locale;
  footerSetting?: any;
  globalSetting?: any;
  logoUrl?: string;
  siteName?: string;
  siteDescription?: string;
}

const { lang: langProp, locale: localeProp, footerSetting: footerProp, globalSetting: globalProp, logoUrl: logoProp, siteName: siteNameProp, siteDescription: siteDescProp } = Astro.props;
const lang = (langProp || localeProp || "th") as Locale;
const t = getLocale(lang);

// Use pre-fetched data from BaseLayout or fetch from CMS as fallback
let cmsSettings: any = globalProp || null;
let footerSettings: any = footerProp || null;

if (!footerProp || !globalProp) {
  try {
    if (!globalProp) cmsSettings = await getGlobalSetting(lang);
    if (!footerProp) footerSettings = await getFooterSetting(lang);
  } catch {
    // CMS offline — fallbacks below handle it
  }
}

// Extract contact info from ContactInfo[] array by label matching
const contactItems = (cmsSettings?.contactInfo || [])
  .filter((item) => item.isActive !== false)
  .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0));

function findContactValue(labelPatterns: string[]): string {
  const item = contactItems.find((item) =>
    labelPatterns.some((pattern) => item.label?.toLowerCase().includes(pattern.toLowerCase()))
  );
  return item?.value || "";
}

const logoUrl = logoProp || getStrapiAbsoluteImageUrl(cmsSettings?.siteLogo) || "https://istockexpress.com/wp-content/uploads/2025/06/427512075_725937109519350_4928615355768631556_n-e1750601800316.jpg";
const socialLinks = (footerSettings as any)?.socialLinks || {};
const footerStats = (footerSettings?.stats?.length ? footerSettings.stats : cmsSettings?.stats || [])
  .slice()
  .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0));
const legalLinks = footerSettings?.legalLinks
  ?.filter((link) => link.isActive !== false)
  .slice()
  .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0)) || [];

const fallbackFooterSections = [
  {
    title: lang === "th" ? "ผลิตภัณฑ์" : "Products",
    links: [
      { label: t.products.istockExpress, url: "/istock-express/", sortOrder: 1 },
      { label: t.products.istockExpressPro, url: "/istock-express-pro/", sortOrder: 2 },
      { label: t.products.istockWMS, url: "/istock-wms/", sortOrder: 3 },
      { label: t.products.istockSalesOrder, url: "/istock-sales-order/", sortOrder: 4 },
      { label: t.products.istockTMS, url: "/istock-tms/", sortOrder: 5 },
      { label: t.products.rfidSystem, url: "/rfid-system/", sortOrder: 6 },
    ],
    sortOrder: 1,
  },
  {
    title: lang === "th" ? "ซัพพอร์ต" : "Support",
    links: [
      { label: t.nav.support, url: "/support/", sortOrder: 1 },
      { label: "FAQ", url: "/support/#faqs-section", sortOrder: 2 },
      { label: lang === "th" ? "ศูนย์ช่วยเหลือ" : "Help Center", url: "/support/#help-center", sortOrder: 3 },
      { label: t.nav.downloads, url: "/downloads/", sortOrder: 4 },
      { label: t.nav.freeTrial, url: "/free-trial/", sortOrder: 5 },
    ],
    sortOrder: 2,
  },
];

const footerSections = (footerSettings?.footerSections?.length ? footerSettings.footerSections : fallbackFooterSections)
  .filter((section) => section.isActive !== false)
  .slice()
  .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0))
  .map((section) => ({
    ...section,
    links: (section.links || [])
      .filter((link) => link.isActive !== false)
      .slice()
      .sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0)),
  }));

function normalizeInternalUrl(url?: string) {
  if (!url) return "#";
  if (/^(https?:|mailto:|tel:|#)/.test(url)) return url;
  return url.startsWith("/") ? `${t.home}${url.replace(/^\//, "")}` : url;
}

function getFooterLinkUrl(link: { url?: string; productPage?: { slug?: string } }) {
  if (link.productPage?.slug) return `${t.home}${link.productPage.slug}/`;
  return normalizeInternalUrl(link.url);
}

const contactAddress = findContactValue(["address", "ที่อยู่"]) || t.footer.address;
const contactPhone = findContactValue(["phone", "tel", "โทรศัพท์"]) || t.footer.phone;
const contactEmail = findContactValue(["email", "mail", "อีเมล"]) || t.footer.email;
const contactHours = findContactValue(["hour", "time", "เวลา", "business"]) || t.footer.hours;
const contactPhoneHref = `tel:${contactPhone.replace(/[^\d+]/g, "")}`;
const primaryCtaHref = normalizeInternalUrl(footerSettings?.primaryCtaUrl || "free-trial/");
const secondaryCtaHref = normalizeInternalUrl(footerSettings?.secondaryCtaUrl || "https://lin.ee/Kd8yzFQ");
const isSecondaryCtaExternal = /^(https?:)?\/\//.test(secondaryCtaHref);
---

<!-- CTA Section -->
<section class="footer-cta">
  <div class="footer-cta-bg"></div>
  <div class="container footer-cta-inner">
    <div class="footer-cta-content">
      <span class="footer-cta-badge">
        <span class="footer-cta-dot"></span>
        {footerSettings?.ctaBadge || (lang === "th" ? "เริ่มต้นเลย" : "Get Started")}
      </span>
      <h2>{footerSettings?.ctaTitle || (lang === "th" ? "พร้อมเริ่มต้นใช้ iStock Express หรือยัง?" : "Ready to Start with iStock Express?")}</h2>
      <p>{footerSettings?.ctaDescription || (lang === "th" ? "ธุรกิจของคุณไม่ควรหยุดเพราะ Stock พลาด เริ่มใช้ฟรีทันที!" : "Your business shouldn't stop because of stock mistakes. Start using for free now!")}</p>
      <div class="footer-cta-buttons">
        <a href={primaryCtaHref} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          {footerSettings?.primaryCtaLabel || (lang === "th" ? "ทดลองใช้งานฟรี" : "Try for Free")}
        </a>
        <a href={secondaryCtaHref} target={isSecondaryCtaExternal ? "_blank" : "_self"} rel={isSecondaryCtaExternal ? "noopener noreferrer" : undefined} class="btn btn-outline-light btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          {footerSettings?.secondaryCtaLabel || (lang === "th" ? "ติดต่อสั่งซื้อ" : "Contact to Order")}
        </a>
      </div>
    </div>

    <!-- Mobile Feature Highlights -->
    <div class="footer-cta-highlights">
      <a href={`${t.home}downloads/`} class="highlight-card">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <span class="highlight-label">{lang === "th" ? "คู่มือ" : "Guide"}</span>
        <span class="highlight-sub">{lang === "th" ? "ดาวน์โหลดฟรี" : "Free"}</span>
      </a>
      <a href={`${t.home}support/#help-center`} class="highlight-card">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <span class="highlight-label">{lang === "th" ? "ช่วยเหลือ" : "Support"}</span>
        <span class="highlight-sub">24/7</span>
      </a>
      <a href={`${t.home}support/#faqs-section`} class="highlight-card">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <span class="highlight-label">FAQ</span>
        <span class="highlight-sub">{lang === "th" ? "คำถามทั่วไป" : "Questions"}</span>
      </a>
      <a href={contactPhoneHref} class="highlight-card">
        <div class="highlight-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <span class="highlight-label">{lang === "th" ? "โทรศัพท์" : "Phone"}</span>
        <span class="highlight-sub">{contactPhone}</span>
      </a>
    </div>
  </div>
</section>

<!-- Trust Bar -->
<section class="footer-trust">
  <div class="container">
    <div class="trust-grid">
      {footerStats.length > 0 ? footerStats.slice(0, 4).map((stat) => (
        <div class="trust-item">
          <span class="trust-value">{stat.value}</span>
          <span class="trust-label">{stat.label}</span>
        </div>
      )) : (
        <>
          <div class="trust-item">
            <span class="trust-value">15+</span>
            <span class="trust-label">{lang === "th" ? "ปีประสบการณ์" : "Years Experience"}</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">500+</span>
            <span class="trust-label">{lang === "th" ? "ลูกค้าที่ไว้ใจ" : "Trusted Clients"}</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">99.9%</span>
            <span class="trust-label">{lang === "th" ? "เวลาทำงาน" : "Uptime"}</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">24/7</span>
            <span class="trust-label">{lang === "th" ? "ซัพพอร์ต" : "Support"}</span>
          </div>
        </>
      )}
    </div>
  </div>
</section>

<!-- Main Footer -->
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Company Info -->
      <div class="footer-brand">
        <a href={t.home} class="footer-logo">
          <img src={logoUrl} alt="iStock Express" />
        </a>
        <p class="footer-desc">
          {footerSettings?.companyDescription || (lang === "th" 
            ? "ระบบบริหารจัดการสต็อกสินค้าสมัยใหม่ ช่วยเพิ่มประสิทธิภาพในการทำงาน ลดต้นทุนและเพิ่มผลกำไร"
            : "Modern inventory management system that boosts efficiency, reduces costs, and increases profits")}
        </p>
        <div class="footer-social">
          {socialLinks.facebook && (
            <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {socialLinks.line && (
            <a href={socialLinks.line} target="_blank" rel="noopener noreferrer" class="social-link social-line" aria-label="LINE">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.271.173-.508.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
            </a>
          )}
          {socialLinks.linkedin && (
            <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {socialLinks.youtube && (
            <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Navigation Sections -->
      {footerSections.map((section) => (
        <div class="footer-nav">
          <h4>{section.title}</h4>
          <ul>
            {section.links.map((link) => (
              <li>
                <a
                  href={getFooterLinkUrl(link)}
                  target={link.target || "_self"}
                  rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Contact Info -->
      <div class="footer-contact">
        <h4>{lang === "th" ? "ติดต่อเรา" : "Contact Us"}</h4>
        <ul>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{contactAddress}</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href={contactPhoneHref}>{contactPhone}</a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{contactHours}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<!-- Bottom Bar -->
<div class="footer-bottom">
  <div class="container">
    <div class="footer-bottom-inner">
      <p>{footerSettings?.copyright || `© ${new Date().getFullYear()} ${seoConfig?.brandName || "Icon Solutions Co., Ltd."}. ${lang === "th" ? "สงวนลิขสิทธิ์" : "All rights reserved"}`}</p>
      <div class="footer-legal">
        {legalLinks.length > 0 ? legalLinks.map((link) => (
          <a
            href={normalizeInternalUrl(link.url)}
            target={link.target || "_self"}
            rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        )) : (
          <>
            <a href={`${t.home}privacy/`}>{lang === "th" ? "นโยบายความเป็นส่วนตัว" : "Privacy Policy"}</a>
            <a href={`${t.home}cookie-policy/`}>{lang === "th" ? "นโยบายคุกกี้" : "Cookie Policy"}</a>
            <a href={`${t.home}privacy-request/`}>{lang === "th" ? "คำขอข้อมูล" : "Data Request"}</a>
            <a href={`${t.home}terms-of-service/`}>{lang === "th" ? "เงื่อนไขการให้บริการ" : "Terms of Service"}</a>
          </>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  /* ─── CTA Section ──────────────────────────────────────────────── */
  .footer-cta {
    position: relative;
    background: linear-gradient(135deg, #017FE4 0%, #005CB8 100%);
    padding: 80px 0;
    overflow: hidden;
  }

  .footer-cta-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(255,255,255,0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(255,255,255,0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .footer-cta-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  .footer-cta-content {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .footer-cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
  }

  .footer-cta-dot {
    width: 8px;
    height: 8px;
    background: #FFFFFF;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .footer-cta h2 {
    font-size: 36px;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .footer-cta p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .footer-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .btn-outline-light {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
