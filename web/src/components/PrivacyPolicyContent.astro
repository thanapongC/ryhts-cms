---
/**
 * PrivacyPolicyContent — Renders the Privacy Policy page with CMS data + fallback.
 *
 * CMS data: hero, applies-to product relations, policy sections, legal contact info, related links, SEO.
 * Rules: integate-rule.md §18 Privacy
 *
 * Props:
 *   lang: Locale
 *   policy: PrivacyPolicy | null
 */
import { getStrapiAbsoluteImageUrl, filterAndSort, normalizeInternalUrl, type PrivacyPolicy, type TermsOfService } from "../lib/api";

interface Props {
  lang: "th" | "en";
  policy: PrivacyPolicy | TermsOfService | null;
  pageType?: "privacy" | "terms";
}

const { lang, policy, pageType = "privacy" } = Astro.props;

const t = { home: `/${lang}/` };
const seo = policy?.seo;
const policySections = filterAndSort(policy?.sections || policy?.policySections);
const relatedLinks = filterAndSort(policy?.relatedLinks);
const appliesToProducts = policy?.appliesToProducts || [];
const contactInfo = policy?.legalContactInfo || policy?.contactInfo?.[0] || null;
const fallbackTitle = pageType === "terms"
  ? (lang === "en" ? "Terms of Service" : "ข้อกำหนดการใช้บริการ")
  : (lang === "en" ? "Privacy Policy" : "นโยบายความเป็นส่วนตัว");
const pageTitle = policy?.heroTitle || policy?.title || fallbackTitle;
const pageDescription = policy?.heroSubtitle || policy?.description || "";
const tocTitle = policy?.tocTitle || (lang === "en" ? "Contents" : "สารบัญ");
const appliesToTitle = policy?.appliesToTitle || (lang === "en" ? "Applies to products" : "มีผลกับสินค้า");
const relatedLinksTitle = policy?.relatedLinksTitle || (lang === "en" ? "Related Policies" : "นโยบายที่เกี่ยวข้อง");
const contactTitle = policy?.legalContactTitle || (lang === "en" ? "Contact Us" : "ติดต่อเรา");
const contactDescription = policy?.legalContactDescription || (lang === "en"
  ? "If you have questions about this policy, please contact us."
  : "หากมีคำถามเกี่ยวกับนโยบายนี้ กรุณาติดต่อเรา");

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString(lang === "en" ? "en-US" : "th-TH", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function getProductUrl(product: { slug?: string }): string {
  if (product?.slug) return `${t.home}products/${product.slug}/`;
  return "#";
}

function getProductLabel(product: { pageTitle?: string; name?: string; title?: string }): string {
  return product.pageTitle || product.name || product.title || "";
}
---

<div class="pp-hero">
  <div class="container">
    {policy?.featuredImage && (
      <img src={getStrapiAbsoluteImageUrl(policy.featuredImage)} alt={pageTitle} class="pp-hero-image" />
    )}
    {policy?.heroBadge && <span class="pp-badge">{policy.heroBadge}</span>}
    <h1>{pageTitle}</h1>
    {pageDescription && <p class="pp-hero-description">{pageDescription}</p>}
    <div class="pp-dates">
      {policy?.effectiveDate && (
        <span>{lang === "en" ? "Effective" : "มีผลบังคับใช้"}: {formatDate(policy.effectiveDate)}</span>
      )}
      {policy?.lastUpdated && (
        <span>{lang === "en" ? "Last updated" : "อัปเดตล่าสุด"}: {formatDate(policy.lastUpdated)}</span>
      )}
    </div>
  </div>
</div>

<section class="section">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={t.home}>{lang === "en" ? "Home" : "หน้าแรก"}</a>
      <span>/</span>
      <span>{pageTitle}</span>
    </nav>

    <!-- Summary -->
    {pageDescription && (
      <div class="pp-summary">
        <p>{pageDescription}</p>
      </div>
    )}

    <!-- Applies To Products -->
    {appliesToProducts.length > 0 && (
      <div class="pp-products">
        <h3>{appliesToTitle}</h3>
        <div class="pp-product-chips">
          {appliesToProducts.map((product) => (
            <a href={getProductUrl(product)} class="pp-chip">{getProductLabel(product)}</a>
          ))}
        </div>
      </div>
    )}

    <!-- Policy Sections -->
    {policySections.length > 0 ? (
      <div class="pp-sections">
        <!-- Table of Contents -->
        <nav class="pp-toc">
          <h3>{tocTitle}</h3>
          <ol>
            {policySections.map((section) => (
              <li>
                <a href={`#section-${section.title}`}>{section.title}</a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="pp-content">
          {policySections.map((section) => (
            <div class="pp-section" id={`section-${section.title}`}>
              <h2>{section.title}</h2>
              <div class="rich-text" set:html={section.content} />
            </div>
          ))}
        </div>
      </div>
    ) : policy?.content ? (
      <div class="pp-content">
        <div class="rich-text" set:html={policy.content} />
      </div>
    ) : (
      <p>{lang === "en" ? "Privacy policy content is not yet available." : "เนื้อหานโยบายความเป็นส่วนตัวยังไม่พร้อมใช้งาน"}</p>
    )}

    <!-- Related Links -->
    {relatedLinks.length > 0 && (
      <div class="pp-related">
        <h3>{relatedLinksTitle}</h3>
        <div class="pp-related-list">
          {relatedLinks.map((link) => (
            <a href={normalizeInternalUrl(link.url, t.home)} class="pp-related-link">
              <i class="fas fa-file-alt"></i>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Contact Information -->
    {contactInfo && (
      <div class="pp-contact">
        <h3>{contactTitle}</h3>
        <p>{contactDescription}</p>
        <div class="pp-contact-items">
          {contactInfo.companyName && (
            <div class="pp-contact-item">
              <i class="fas fa-building"></i>
              <div>
                <strong>{lang === "en" ? "Company" : "บริษัท"}</strong>
                <span>{contactInfo.companyName}</span>
              </div>
            </div>
          )}
          {contactInfo.email && (
            <div class="pp-contact-item">
              <i class="fas fa-envelope"></i>
              <div>
                <strong>Email</strong>
                <span>{contactInfo.email}</span>
              </div>
            </div>
          )}
          {contactInfo.phone && (
            <div class="pp-contact-item">
              <i class="fas fa-phone"></i>
              <div>
                <strong>{lang === "en" ? "Phone" : "โทรศัพท์"}</strong>
                <span>{contactInfo.phone}</span>
              </div>
            </div>
          )}
          {contactInfo.businessHours && (
            <div class="pp-contact-item">
              <i class="fas fa-clock"></i>
              <div>
                <strong>{lang === "en" ? "Business Hours" : "เวลาทำการ"}</strong>
                <span>{contactInfo.businessHours}</span>
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .pp-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #FFFFFF;
    padding: 140px 0 60px;
    text-align: center;
  }

  .pp-hero-image {
    max-width: 100%;
    max-height: 200px;
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
  }

  .pp-hero h1 {
    font-size: 36px;
    margin-bottom: 12px;
    color: #FFFFFF;
  }

  .pp-badge {
    display: inline-flex;
    margin-bottom: 16px;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
  }

  .pp-hero-description {
    max-width: 760px;
    margin: 0 auto 16px;
    color: #E0F2FE;
    line-height: 1.7;
  }

  .pp-dates {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-size: 14px;
    opacity: 0.85;
  }

  .pp-summary {
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
    padding: 20px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  .pp-products {
    margin-bottom: 32px;
  }

  .pp-products h3 {
    font-size: 16px;
    margin-bottom: 12px;
  }

  .pp-product-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pp-chip {
    display: inline-block;
    padding: 6px 16px;
    background: var(--color-background-blue);
    color: var(--color-primary);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
  }

  .pp-chip:hover {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .pp-sections {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
  }

  .pp-toc {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .pp-toc h3 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .pp-toc ol {
    list-style: none;
    padding: 0;
  }

  .pp-toc li {
    margin-bottom: 8px;
  }

  .pp-toc a {
    font-size: 14px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .pp-toc a:hover {
    color: var(--color-primary);
  }

  .pp-section {
    margin-bottom: 32px;
  }

  .pp-section h2 {
    font-size: 20px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-background-blue);
    color: var(--color-text-primary);
  }

  .pp-related {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .pp-related h3 {
    font-size: 18px;
    margin-bottom: 16px;
  }

  .pp-related-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pp-related-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all var(--transition);
  }

  .pp-related-link:hover {
    background: var(--color-background-blue);
    color: var(--color-primary);
    border-color: var(--color-border-blue);
  }

  .pp-contact {
    margin-top: 48px;
    padding: 32px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .pp-contact h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .pp-contact > p {
    font-size: 15px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .pp-contact-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .pp-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .pp-contact-item i {
    color: var(--color-primary);
    margin-top: 2px;
  }

  .pp-contact-item strong {
    display: block;
    font-size: 14px;
    margin-bottom: 2px;
  }

  .pp-contact-item span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .pp-hero { padding: 120px 0 40px; }
    .pp-hero h1 { font-size: 28px; }
    .pp-dates { flex-direction: column; gap: 4px; }
    .pp-sections { grid-template-columns: 1fr; }
    .pp-toc { position: static; margin-bottom: 24px; }
    .pp-contact-items { grid-template-columns: 1fr; }
  }
</style>
