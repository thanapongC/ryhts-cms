---
/**
 * PrivacyPolicyContent — Renders the Privacy Policy page with CMS data + fallback.
 *
 * CMS data: hero, applies-to product relations, policy sections, legal contact info, related links, SEO.
 * Rules: integate-rule.md §18 Privacy
 *
 * Props:
 *   lang: Locale
 *   policy: PrivacyPolicy | null
 */
import { getStrapiMedia, getStrapiAbsoluteImageUrl, filterAndSort, normalizeInternalUrl, type PrivacyPolicy } from "../lib/api";

interface Props {
  lang: "th" | "en";
  policy: PrivacyPolicy | null;
}

const { lang, policy } = Astro.props;

const t = { home: `/${lang}/` };
const seo = policy?.seo;
const policySections = filterAndSort(policy?.policySections);
const relatedLinks = filterAndSort(policy?.relatedLinks);
const appliesToProducts = policy?.appliesToProducts || [];
const contactInfo = policy?.contactInfo || [];

function formatDate(dateStr: string): string {
  if (!dateStr) return "";
  return new Date(dateStr).toLocaleDateString(lang === "en" ? "en-US" : "th-TH", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function getProductUrl(product: { slug?: string }): string {
  if (product?.slug) return `${t.home}products/${product.slug}/`;
  return "#";
}
---

<div class="pp-hero">
  <div class="container">
    {policy?.featuredImage && (
      <img src={getStrapiAbsoluteImageUrl(policy.featuredImage)} alt={policy?.title || ""} class="pp-hero-image" />
    )}
    <h1>{policy?.title || (lang === "en" ? "Privacy Policy" : "นโยบายความเป็นส่วนตัว")}</h1>
    <div class="pp-dates">
      {policy?.effectiveDate && (
        <span>{lang === "en" ? "Effective" : "มีผลบังคับใช้"}: {formatDate(policy.effectiveDate)}</span>
      )}
      {policy?.lastUpdated && (
        <span>{lang === "en" ? "Last updated" : "อัปเดตล่าสุด"}: {formatDate(policy.lastUpdated)}</span>
      )}
    </div>
  </div>
</div>

<section class="section">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={t.home}>{lang === "en" ? "Home" : "หน้าแรก"}</a>
      <span>/</span>
      <span>{lang === "en" ? "Privacy Policy" : "นโยบายความเป็นส่วนตัว"}</span>
    </nav>

    <!-- Summary -->
    {policy?.description && (
      <div class="pp-summary">
        <p>{policy.description}</p>
      </div>
    )}

    <!-- Applies To Products -->
    {appliesToProducts.length > 0 && (
      <div class="pp-products">
        <h3>{lang === "en" ? "Applies to products" : "มีผลกับสินค้า"}</h3>
        <div class="pp-product-chips">
          {appliesToProducts.map((product) => (
            <a href={getProductUrl(product)} class="pp-chip">{product.title}</a>
          ))}
        </div>
      </div>
    )}

    <!-- Policy Sections -->
    {policySections.length > 0 ? (
      <div class="pp-sections">
        <!-- Table of Contents -->
        <nav class="pp-toc">
          <h3>{lang === "en" ? "Contents" : "สารบัญ"}</h3>
          <ol>
            {policySections.map((section) => (
              <li>
                <a href={`#section-${section.title}`}>{section.title}</a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="pp-content">
          {policySections.map((section) => (
            <div class="pp-section" id={`section-${section.title}`}>
              <h2>{section.title}</h2>
              <div class="rich-text" set:html={section.content} />
            </div>
          ))}
        </div>
      </div>
    ) : policy?.content ? (
      <div class="pp-content">
        <div class="rich-text" set:html={policy.content} />
      </div>
    ) : (
      <p>{lang === "en" ? "Privacy policy content is not yet available." : "เนื้อหานโยบายความเป็นส่วนตัวยังไม่พร้อมใช้งาน"}</p>
    )}

    <!-- Related Links -->
    {relatedLinks.length > 0 && (
      <div class="pp-related">
        <h3>{lang === "en" ? "Related Policies" : "นโยบายที่เกี่ยวข้อง"}</h3>
        <div class="pp-related-list">
          {relatedLinks.map((link) => (
            <a href={normalizeInternalUrl(link.url, t.home)} class="pp-related-link">
              <i class="fas fa-file-alt"></i>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Contact Information -->
    {contactInfo.length > 0 && (
      <div class="pp-contact">
        <h3>{lang === "en" ? "Contact Us" : "ติดต่อเรา"}</h3>
        <p>{lang === "en"
          ? "If you have questions about this policy, please contact us."
          : "หากมีคำถามเกี่ยวกับนโยบายนี้ กรุณาติดต่อเรา"
        }</p>
        <div class="pp-contact-items">
          {contactInfo.map((item) => (
            <div class="pp-contact-item">
              {item.icon && <i class={`fas fa-${item.icon}`}></i>}
              <div>
                {item.label && <strong>{item.label}</strong>}
                <span>{item.value}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .pp-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #FFFFFF;
    padding: 140px 0 60px;
    text-align: center;
  }

  .pp-hero-image {
    max-width: 100%;
    max-height: 200px;
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
  }

  .pp-hero h1 {
    font-size: 36px;
    margin-bottom: 12px;
    color: #FFFFFF;
  }

  .pp-dates {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-size: 14px;
    opacity: 0.85;
  }

  .pp-summary {
    font-size: 17px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 32px;
    padding: 20px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  .pp-products {
    margin-bottom: 32px;
  }

  .pp-products h3 {
    font-size: 16px;
    margin-bottom: 12px;
  }

  .pp-product-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pp-chip {
    display: inline-block;
    padding: 6px 16px;
    background: var(--color-background-blue);
    color: var(--color-primary);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
  }

  .pp-chip:hover {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .pp-sections {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
  }

  .pp-toc {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .pp-toc h3 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .pp-toc ol {
    list-style: none;
    padding: 0;
  }

  .pp-toc li {
    margin-bottom: 8px;
  }

  .pp-toc a {
    font-size: 14px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .pp-toc a:hover {
    color: var(--color-primary);
  }

  .pp-section {
    margin-bottom: 32px;
  }

  .pp-section h2 {
    font-size: 20px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-background-blue);
    color: var(--color-text-primary);
  }

  .pp-related {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .pp-related h3 {
    font-size: 18px;
    margin-bottom: 16px;
  }

  .pp-related-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pp-related-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: all var(--transition);
  }

  .pp-related-link:hover {
    background: var(--color-background-blue);
    color: var(--color-primary);
    border-color: var(--color-border-blue);
  }

  .pp-contact {
    margin-top: 48px;
    padding: 32px;
    background: var(--color-background-soft);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .pp-contact h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .pp-contact > p {
    font-size: 15px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .pp-contact-items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .pp-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .pp-contact-item i {
    color: var(--color-primary);
    margin-top: 2px;
  }

  .pp-contact-item strong {
    display: block;
    font-size: 14px;
    margin-bottom: 2px;
  }

  .pp-contact-item span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .pp-hero { padding: 120px 0 40px; }
    .pp-hero h1 { font-size: 28px; }
    .pp-dates { flex-direction: column; gap: 4px; }
    .pp-sections { grid-template-columns: 1fr; }
    .pp-toc { position: static; margin-bottom: 24px; }
    .pp-contact-items { grid-template-columns: 1fr; }
  }
</style>
