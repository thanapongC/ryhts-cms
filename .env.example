# ============================================
# i-Stock Express - Environment Configuration
# ============================================
# Copy this file to .env and update values
# cp .env.example .env

# ---- CMS ----
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://istockcms.icute.site
ADMIN_REGISTRATION_DISABLED=true

# ---- Strapi Secrets ----
# Generate fresh values: openssl rand -hex 32
APP_KEYS=CHANGE_ME_SECRET_1,CHANGE_ME_SECRET_2
API_TOKEN_SALT=CHANGE_ME_SECRET
ADMIN_JWT_SECRET=CHANGE_ME_SECRET
TRANSFER_TOKEN_SALT=CHANGE_ME_SECRET
JWT_SECRET=CHANGE_ME_SECRET
ENCRYPTION_KEY=CHANGE_ME_SECRET

# ---- Database ----
DATABASE_CLIENT=postgres
DATABASE_HOST=139.59.125.25
DATABASE_PORT=5432
DATABASE_NAME=ryhts
DATABASE_USERNAME=admin
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_SSL=false

# ---- Web ----
PUBLIC_STRAPI_URL=https://istockcms.icute.site
PUBLIC_SITE_URL=https://istockweb.icute.site
STRAPI_URL=https://istockcms.icute.site
STRAPI_API_TOKEN=CHANGE_ME_STRAPI_API_TOKEN

# ---- Contact Form Email ----
GMAIL_SMTP_USER=your-gmail-address@example.com
GMAIL_SMTP_PASSWORD=your-google-app-password
FORM_RECIPIENT_EMAIL=your-gmail-address@example.com

# ---- Docker ----
DOCKER_IMAGE_PREFIX=ryhts-ribbon
DOCKER_USERNAME=CHANGE_ME
DOCKER_PASSWORD=CHANGE_ME

# ---- VPS ----
VPS_HOST=CHANGE_ME
VPS_USER=root
VPS_SSH_KEY=~/.ssh/istock_deploy

# ---- Ports ----
CMS_PORT=1338
WEB_PORT=3008

# ---- Cache ----
CACHE_SECRET=CHANGE_ME_SECRET
WEB_CONTENT_VERSION=local

# ---- SSL / Domains ----
ADMIN_EMAIL=thanapognchunchombun@gmail.com
CMS_DOMAIN=ryhtscms.icute.site
WEB_DOMAIN=ryhtsweb.icute.site

# ---- Backup Settings ----
# Used by scripts/backup-db.sh
BACKUP_SERVER_HOST=139.59.125.25
BACKUP_SERVER_USER=root
BACKUP_SSH_KEY=~/.ssh/istock_deploy
BACKUP_DB_HOST=postgres
BACKUP_DB_PORT=5432
BACKUP_DB_USER=admin
BACKUP_DB_NAME=ryhts
BACKUP_DIR=./backup
# Backup password is read from DATABASE_PASSWORD if not set
# BACKUP_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
