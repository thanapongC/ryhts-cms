# ============================================
# Gmail SMTP Configuration for Strapi Email
# ============================================
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an App Password for "Mail"
# 3. Copy the 16-character password below
#
# NOTE: You MUST enable 2-Factor Authentication on your Google account first
#       before you can create an App Password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
SMTP_REPLY_TO=your-email@gmail.com
